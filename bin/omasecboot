#!/bin/bash
# shellcheck disable=SC2154 # Command handlers consume globals set by sourced modules.
set -euo pipefail

# OmaSecBoot: lifecycle boundary for Secure Boot state and boot mutation hooks.

# Resolve the library directory relative to the installed command
# (/usr/bin/omasecboot -> /usr/lib/omasecboot)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib/omasecboot"
# Fallback for development (running from repo checkout)
[[ -d "$LIB_DIR" ]] || LIB_DIR="${SCRIPT_DIR}/../lib"

for lib in common lifecycle checks discover sign producers enroll windows status; do
  # shellcheck source=/dev/null
  source "${LIB_DIR}/${lib}.sh"
done

current_omasecboot_executable_path() {
  readlink -f "${BASH_SOURCE[0]}"
}

activation_hook_path() {
  case "$1" in
    removal) printf '/usr/share/libalpm/hooks/00-omasecboot-removal-guard.hook\n' ;;
    transaction) printf '/usr/share/libalpm/hooks/00-omasecboot-transition-guard.hook\n' ;;
    package-sign) printf '/usr/share/libalpm/hooks/zzz-omasecboot.hook\n' ;;
    limine-pre) printf '/etc/boot/hooks/pre.d/000-omasecboot-guard\n' ;;
    limine-post) printf '/etc/boot/hooks/post.d/zzz-omasecboot-sign\n' ;;
    *) return 1 ;;
  esac
}

validate_activation_hook() {
  local key="$1" command="$2" path expected template expected_hash
  local document normalized actual_hash executable=false
  path=$(activation_hook_path "$key") || return 1
  case "$key" in
    removal)
      expected="Exec = ${command} --quiet guard removal"
      expected_hash=f70bc5a660776e2a5dd4ea5e8184a61b1adc547db4c3286a69b355383f1eb56d
      ;;
    transaction)
      expected="Exec = ${command} --quiet guard transaction"
      expected_hash=cedd35b7b7209cb01587649fba225907c3552b837a03f8f609fd063154e99f5f
      ;;
    package-sign)
      expected="Exec = ${command} --quiet hook package-sign"
      expected_hash=6250350574ba80e09c65a1f49571df2e925e6976254b32868fae3ea132b4a0c9
      ;;
    limine-pre)
      expected="exec ${command} --quiet hook pre"
      expected_hash=ea5485e3cc7a1470329f54b96bee38cc5edc1a9746878bf241183144432a2807
      executable=true
      ;;
    limine-post)
      expected="exec ${command} --quiet hook post"
      expected_hash=0ecf4826228641befc2bff8df14ad28c0b0431e23b8366353b63cebac7eb7d05
      executable=true
      ;;
    *) return 1 ;;
  esac
  validate_control_file "$path" || return 1
  [[ "$executable" == false || -x "$path" ]] || return 1
  if [[ "$executable" == false ]] && pacman_hook_is_shadowed "$path"; then
    return 1
  fi
  document=$(<"$path") || return 1
  [[ "$document" == *"$expected"* ]] || return 1
  template=${expected/"$command"/@BINDIR@\/omasecboot}
  normalized=${document/"$expected"/"$template"}
  actual_hash=$(sha256_text "$normalized") || return 1
  [[ "$actual_hash" == "$expected_hash" ]]
}

lifecycle_activation_environment_is_ready() {
  local command key
  command=$(current_omasecboot_executable_path) || return 1
  validate_control_file "$command" && [[ -x "$command" ]] || return 1
  [[ $(producer_package_version limine-mkinitcpio-hook) == \
      "$SUPPORTED_LIMINE_MKINITCPIO_VERSION" \
    && $(producer_package_version limine-snapper-sync) == \
      "$SUPPORTED_LIMINE_SNAPPER_SYNC_VERSION" \
    && $(producer_package_version sbctl) == "$SUPPORTED_SBCTL_VERSION" ]] || {
    fail "Lifecycle activation requires the exact supported producer packages"
    return 1
  }
  version_at_least "$(producer_package_version efibootmgr)" \
    "$WINDOWS_EFIBOOTMGR_MINIMUM_VERSION" || {
    fail "Lifecycle activation requires efibootmgr ${WINDOWS_EFIBOOTMGR_MINIMUM_VERSION} or newer"
    return 1
  }
  unconfigure_limine_tools_are_pinned || {
    fail "Lifecycle activation requires the supported unconfiguration tools"
    return 1
  }
  for key in removal transaction package-sign limine-pre limine-post; do
    validate_activation_hook "$key" "$command" || {
      fail "Lifecycle activation requires the current installed, unshadowed ${key} hook"
      return 1
    }
  done
}

# Shared entry of every recoverable mutation command: root, recovery
# dependencies, then any pending lifecycle recovery. Callers check
# _lifecycle_recovery_performed and report instead of starting new work.
recoverable_command_prelude() {
  local name="$1"
  check_root "$name"
  check_recovery_deps
  recover_lifecycle_if_required || {
    fail "Lifecycle recovery failed; no new ${name} mutation was attempted"
    return 1
  }
}

# --- Commands ----------------------------------------------------------------

cmd_setup() {
  local backup_id state repair_required=true backup_rc=0
  [[ $# -eq 0 ]] || {
    fail "Setup does not accept arguments"
    return 2
  }
  header "Secure Boot Setup"
  recoverable_command_prelude "setup" || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run setup again to start a new setup mutation"
    return 0
  fi
  check_deps
  check_efi_mode
  require_gum

  backup_id=$(current_setup_backup_id) || backup_rc=$?
  if (( backup_rc == 2 )); then
    fail "The recorded firmware backup or enrollment plan failed validation; setup will not replace it"
    return 1
  fi
  if [[ -z "$backup_id" ]]; then
    gum confirm "Back up firmware trust and prepare a Secure Boot enrollment plan?" \
      || return 1
    prepare_state_aware_setup true || return 1
    backup_id=$(current_setup_backup_id) || return 1
  fi
  if ! validate_enrollment_plan "$backup_id" true >/dev/null 2>&1; then
    load_enrollment_pk_fingerprints "$backup_id" || {
      fail "The current Secure Boot enrollment plan is invalid"
      return 1
    }
    echo "  Enrollment plan: $(firmware_plan_path "$backup_id")"
    echo "  Current PK SHA-256: ${_enrollment_current_pk_hash}"
    echo "  Planned PK SHA-256: ${_enrollment_planned_pk_hash}"
    gum confirm "Replace the current PK with the planned OmaSecBoot PK?" || return 1
    gum confirm "Confirm this firmware can delete only PK without clearing KEK, db, or dbx?" \
      || return 1
    gum confirm "Confirm retained trust entries and recovery preparation were reviewed?" \
      || return 1
    activate_confirmed_enrollment_plan "$backup_id" true true true || return 1
    repair_required=false
  fi
  if [[ "$repair_required" == true ]]; then
    run_artifact_repair sign || return 1
  fi
  state=$(observe_setup_state "$backup_id") || return 1
  case "$state" in
    2)
      warn "Setup Mode is active; run sudo omasecboot enroll"
      ;;
    3)
      validate_setup_instruction_boundary "$backup_id" 3 || return 1
      warn "Boot artifacts are proved. In firmware settings, delete only PK to enter Setup Mode."
      warn "Do not clear KEK, db, or dbx; then run sudo omasecboot enroll."
      ;;
    4)
      validate_setup_instruction_boundary "$backup_id" 4 || return 1
      warn "Enrollment is proved with Secure Boot off; enable Secure Boot in firmware settings."
      ;;
    5)
      pass "Secure Boot enrollment is active and matches the confirmed plan"
      ;;
    *)
      fail "Setup reached unsupported state ${state}"
      return 1
      ;;
  esac
}

cmd_enroll() {
  local backup_id state
  [[ $# -eq 0 ]] || {
    fail "Enrollment does not accept arguments"
    return 2
  }
  header "Key Enrollment"
  recoverable_command_prelude "enroll" || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run enroll again to start a new enrollment"
    return 0
  fi
  check_deps
  check_efi_mode
  require_gum
  backup_id=$(current_setup_backup_id) || {
    fail "No current confirmed Secure Boot enrollment plan is available"
    return 1
  }
  state=$(observe_setup_state "$backup_id") || return 1
  if [[ "$state" == 4 || "$state" == 5 ]]; then
    pass "The confirmed Secure Boot trust plan is already enrolled"
    return 0
  fi
  [[ "$state" == 2 ]] || {
    fail "Enrollment requires validated Setup Mode; current setup state is ${state}"
    return 1
  }
  gum confirm "Enroll the confirmed db, KEK, and PK trust plan now?" || return 1
  run_dormant_enrollment "$backup_id" || return 1
  validate_setup_instruction_boundary "$backup_id" 4 || return 1
  warn "Enrollment is proved; enable Secure Boot in firmware settings."
}

verify_adoption_observations() {
  local expected_verification="$1" expected_enrollment="$3"
  local expected_before_save="$5" expected_after_save="$7"
  [[ "$expected_verification" == yes || "$expected_verification" == no \
    || "$expected_verification" == unset ]] || return 1
  [[ "$expected_enrollment" == yes || "$expected_enrollment" == no \
    || "$expected_enrollment" == unset ]] || return 1
  [[ "$expected_before_save" == present || "$expected_before_save" == absent ]] \
    || return 1
  [[ "$expected_after_save" == present || "$expected_after_save" == absent ]] \
    || return 1
  lifecycle_activation_environment_is_ready || return 1
  [[ "$(limine_managed_setting_state ENABLE_VERIFICATION)" == \
    "$expected_verification" ]] || return 1
  [[ "$(limine_managed_setting_state ENABLE_ENROLL_LIMINE_CONFIG)" == \
    "$expected_enrollment" ]] || return 1
  [[ "$(limine_managed_token_state COMMANDS_BEFORE_SAVE limine-reset-enroll)" == \
    "$expected_before_save" ]] || return 1
  [[ "$(limine_managed_token_state COMMANDS_AFTER_SAVE limine-enroll-config)" == \
    "$expected_after_save" ]] || return 1
}

cmd_adopt() {
  local original_verification="" original_enrollment=""
  local original_before_save="" original_after_save=""
  local observed_verification observed_enrollment
  local observed_before_save observed_after_save config

  header "Adopt Existing Configuration"
  while (( $# > 0 )); do
    case "$1" in
      --verification-original)
        [[ $# -ge 2 ]] || die "Missing value for --verification-original"
        original_verification="$2"
        shift 2
        ;;
      --enrollment-original)
        [[ $# -ge 2 ]] || die "Missing value for --enrollment-original"
        original_enrollment="$2"
        shift 2
        ;;
      --before-save-original)
        [[ $# -ge 2 ]] || die "Missing value for --before-save-original"
        original_before_save="$2"
        shift 2
        ;;
      --after-save-original)
        [[ $# -ge 2 ]] || die "Missing value for --after-save-original"
        original_after_save="$2"
        shift 2
        ;;
      *)
        die "Unknown adoption option: $1"
        ;;
    esac
  done

  recoverable_command_prelude adopt || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run adopt again to start a new adoption"
    return 0
  fi
  if [[ "$original_verification" == unknown || "$original_enrollment" == unknown \
    || "$original_before_save" == unknown || "$original_after_save" == unknown ]]; then
    fail "Adoption requires known original values so unconfiguration remains available"
    return 1
  fi
  read_lifecycle || die "Lifecycle state is invalid or unsafe"
  # shellcheck disable=SC2154 # Set by read_lifecycle from the sourced module.
  [[ "$_lifecycle_state" == unmanaged ]] \
    || die "Adoption requires unmanaged state; current state is ${_lifecycle_state}"

  config=$(limine_default_config_path)
  [[ -f "$config" ]] || die "${config} not found"
  observed_verification=$(limine_managed_setting_state ENABLE_VERIFICATION) \
    || die "Could not read a unique ENABLE_VERIFICATION value from ${config}"
  observed_enrollment=$(limine_managed_setting_state ENABLE_ENROLL_LIMINE_CONFIG) \
    || die "Could not read a unique ENABLE_ENROLL_LIMINE_CONFIG value from ${config}"
  observed_before_save=$(limine_managed_token_state COMMANDS_BEFORE_SAVE limine-reset-enroll) \
    || die "Could not read a unique COMMANDS_BEFORE_SAVE value from ${config}"
  observed_after_save=$(limine_managed_token_state COMMANDS_AFTER_SAVE limine-enroll-config) \
    || die "Could not read a unique COMMANDS_AFTER_SAVE value from ${config}"

  echo "  Existing managed settings:"
  echo "    ENABLE_VERIFICATION=${observed_verification}"
  echo "    ENABLE_ENROLL_LIMINE_CONFIG=${observed_enrollment}"
  echo "    COMMANDS_BEFORE_SAVE contains limine-reset-enroll: ${observed_before_save}"
  echo "    COMMANDS_AFTER_SAVE contains limine-enroll-config: ${observed_after_save}"
  echo
  warn "Adoption requires every original value so automatic unconfiguration remains possible"

  if [[ -z "$original_verification" || -z "$original_enrollment" \
    || -z "$original_before_save" || -z "$original_after_save" ]]; then
    require_gum
  fi
  if [[ -z "$original_verification" ]]; then
    original_verification=$(gum choose --header \
      "Original ENABLE_VERIFICATION value" yes no unset) || return 1
  fi
  if [[ -z "$original_enrollment" ]]; then
    original_enrollment=$(gum choose --header \
      "Original ENABLE_ENROLL_LIMINE_CONFIG value" yes no unset) || return 1
  fi
  if [[ -z "$original_before_save" ]]; then
    original_before_save=$(gum choose --header \
      "Was limine-reset-enroll originally in COMMANDS_BEFORE_SAVE?" \
      present absent) || return 1
  fi
  if [[ -z "$original_after_save" ]]; then
    original_after_save=$(gum choose --header \
      "Was limine-enroll-config originally in COMMANDS_AFTER_SAVE?" \
      present absent) || return 1
  fi

  adopt_lifecycle verify_adoption_observations \
    "$observed_verification" "$original_verification" \
    "$observed_enrollment" "$original_enrollment" \
    "$observed_before_save" "$original_before_save" \
    "$observed_after_save" "$original_after_save" \
    || die "Could not commit the adoption record"
  pass "Existing configuration adopted; guarded boot-producer repair is active"
}

cmd_windows_help() {
  header "Windows Dual-Boot"
  echo -e "  ${BOLD}Usage${NC}   sudo omasecboot windows <command>"
  echo
  echo -e "  ${BOLD}Commands${NC}"
  echo "    available   Check the recorded Windows handoff without root or output"
  echo "    preflight   Run the read-only Windows encryption preparation gate"
  echo "    setup       Configure the validated firmware handoff"
  echo "    suppress    Suppress an unsafe managed handoff"
  echo "    bootnext    Request one direct firmware handoff"
  echo
}

cmd_windows_preflight() {
  header "Windows Encryption Preflight"
  check_root "windows preflight"
  windows_encryption_gate
}

cmd_windows() {
  if (( $# > 1 )); then
    cmd_windows_help
    fail "Expected one Windows command"
    return 1
  fi

  case "${1:-}" in
    available)
      read_windows_target_state >/dev/null 2>&1 || return 1
      find_windows_boot_entry >/dev/null || return 1
      windows_state_matches_resolved_target
      ;;
    preflight)
      cmd_windows_preflight
      ;;
    setup)
      recoverable_command_prelude "windows setup" || return 1
      if [[ "$_lifecycle_recovery_performed" == true ]]; then
        pass "Lifecycle recovery completed; run windows setup again for a new mutation"
        return 0
      fi
      check_deps
      check_efi_mode
      add_windows_boot_entry
      ;;
    suppress)
      recoverable_command_prelude "windows suppress" || return 1
      if [[ "$_lifecycle_recovery_performed" == true ]]; then
        pass "Lifecycle recovery completed; run windows suppress again for a new mutation"
        return 0
      fi
      check_deps
      check_efi_mode
      suppress_stale_windows_entry
      ;;
    bootnext)
      recoverable_command_prelude "windows bootnext" || return 1
      if [[ "$_lifecycle_recovery_performed" == true ]]; then
        pass "Lifecycle recovery completed; BootNext was not armed again"
        return 0
      fi
      check_core_deps
      check_efi_mode
      run_dormant_windows_bootnext
      ;;
    help|--help|-h)
      cmd_windows_help
      ;;
    "")
      cmd_windows_help
      return 1
      ;;
    *)
      cmd_windows_help
      fail "Unknown Windows command: $1"
      return 1
      ;;
  esac
}

cmd_cleanup() {
  [[ $# -eq 0 ]] || {
    fail "Cleanup does not accept arguments"
    return 2
  }
  recoverable_command_prelude "cleanup" || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run cleanup again for a new cleanup mutation"
    return 0
  fi
  check_core_deps
  run_tracking_cleanup cleanup
}

cmd_sign() {
  [[ $# -eq 0 ]] || {
    fail "Signing does not accept arguments"
    return 2
  }
  recoverable_command_prelude "sign" || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run sign again for a new signing mutation"
    return 0
  fi
  check_deps
  qheader "Signing EFI Files"
  run_artifact_repair sign
}

cmd_unconfigure() {
  [[ $# -eq 0 ]] || {
    fail "Unconfigure does not accept arguments"
    return 2
  }
  header "Disable OmaSecBoot Management"
  recoverable_command_prelude "unconfigure" || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; no new unconfiguration was started"
    return 0
  fi
  check_deps
  require_gum
  gum confirm "Restore recorded defaults and rebuild stock Limine boot state?" || return 1
  run_dormant_unconfigure
}

cmd_repair() {
  [[ $# -eq 0 ]] || {
    fail "Repair does not accept arguments"
    return 2
  }
  header "Lifecycle Recovery"
  recoverable_command_prelude "repair" || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed"
  else
    pass "No lifecycle recovery is required"
  fi
}

cmd_status() {
  local lifecycle_rc=0 status_rc=0
  [[ $# -eq 0 ]] || return 2
  check_core_deps
  show_lifecycle_status || lifecycle_rc=$?
  show_status || status_rc=$?
  [[ $lifecycle_rc -eq 0 && $status_rc -eq 0 ]]
}

cmd_version() {
  [[ $# -eq 0 ]] || return 2
  printf 'omasecboot %s\n' "$OMASECBOOT_VERSION"
}

cmd_hook() {
  [[ $# -eq 1 ]] || return 2
  case "$1" in
    pre) producer_limine_hook_pre ;;
    post) producer_limine_hook_post ;;
    package-sign) producer_package_post ;;
    *) return 2 ;;
  esac
}

cmd_guard() {
  local rc=0
  [[ $# -eq 1 ]] || return 2
  case "$1" in
    transaction)
      producer_package_pre
      ;;
    removal)
      require_control_root || return 1
      with_boot_repair_lock || return 1
      if ! lifecycle_removal_is_allowed; then
        fail "Package removal requires verified disabled or pristine lifecycle state"
        rc=1
      fi
      release_boot_repair_lock
      return "$rc"
      ;;
    *) return 2 ;;
  esac
}

cmd_help() {
  [[ $# -eq 0 ]] || return 2
  header "Command Help"
  echo "  Secure Boot signing, Limine enrollment, pacman hooks, and Windows BootNext handoff for Omarchy."
  echo "  Mutations use durable recovery and fail closed on unproved state."
  echo
  echo -e "  ${BOLD}Usage${NC}   sudo omasecboot <command>"
  echo
  echo -e "  ${BOLD}Commands${NC}"
  echo "    setup       Prepare and prove the Secure Boot lifecycle"
  echo "    adopt       Record an existing configuration explicitly"
  echo "    enroll      Enroll the confirmed firmware trust plan"
  echo "    windows     Validate and manage the Windows firmware handoff"
  echo "    status      Show Secure Boot status and file verification"
  echo "    sign        Repair and prove managed EFI artifacts"
  echo "    cleanup     Remove stale sbctl tracking entries safely"
  echo "    unconfigure Restore recorded settings and disable management"
  echo "    repair      Resume the registered interrupted operation"
  echo "    version     Show the installed OmaSecBoot version"
  echo "    help        Show this help"
  echo
  echo -e "  ${DIM}Safety:${NC} Change firmware trust only when setup or enroll prints a validated instruction."
  echo
}

# --- Dispatch ----------------------------------------------------------------

main() {
  # Parse global flags
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --quiet) QUIET=true; export QUIET; shift ;;
      *)       break ;;
    esac
  done

  case "${1:-}" in
    setup)    shift; cmd_setup "$@" ;;
    adopt)    shift; cmd_adopt "$@" ;;
    enroll)   shift; cmd_enroll "$@" ;;
    windows)  shift; cmd_windows "$@" ;;
    cleanup)  shift; cmd_cleanup "$@" ;;
    sign)     shift; cmd_sign "$@" ;;
    unconfigure) shift; cmd_unconfigure "$@" ;;
    repair)   shift; cmd_repair "$@" ;;
    status)   shift; cmd_status "$@" ;;
    version|--version|-v) shift; cmd_version "$@" ;;
    hook)     shift; cmd_hook "$@" ;;
    guard)    shift; cmd_guard "$@" ;;
    help|--help|-h)  shift; cmd_help "$@" ;;
    *)
      cmd_help
      if [[ -n "${1:-}" ]]; then
        fail "Unknown command: $1"
        echo
      fi
      return 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
