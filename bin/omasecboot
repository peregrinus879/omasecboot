#!/bin/bash
# shellcheck disable=SC2154 # Command handlers consume globals set by sourced modules.
set -euo pipefail

# OmaSecBoot: lifecycle boundary for Secure Boot state and boot mutation hooks.

# Resolve lib directory (handles symlinks from /usr/local/bin -> /usr/local/lib)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib/omasecboot"
# Fallback for development (running from repo checkout)
[[ -d "$LIB_DIR" ]] || LIB_DIR="${SCRIPT_DIR}/../lib"

for lib in common lifecycle checks discover sign producers enroll windows status; do
  # shellcheck source=/dev/null
  source "${LIB_DIR}/${lib}.sh"
done

# --- Commands ----------------------------------------------------------------

cmd_setup() {
  local backup_id state repair_required=true
  [[ $# -eq 0 ]] || {
    fail "Setup does not accept arguments"
    return 2
  }
  header "Secure Boot Setup"
  lifecycle_repair_is_available || {
    fail "Setup is blocked until recoverable Secure Boot commands are enabled"
    return 1
  }
  check_root "setup"
  check_recovery_deps
  recover_lifecycle_if_required || {
    fail "Lifecycle recovery failed; no new setup mutation was attempted"
    return 1
  }
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run setup again to start a new setup mutation"
    return 0
  fi
  check_deps
  check_efi_mode
  require_gum

  backup_id=$(current_setup_backup_id || true)
  if [[ -z "$backup_id" ]]; then
    gum confirm "Back up firmware trust and prepare a Secure Boot enrollment plan?" \
      || return 1
    prepare_state_aware_setup true || return 1
    backup_id=$(current_setup_backup_id) || return 1
  fi
  if ! validate_enrollment_plan "$backup_id" true >/dev/null 2>&1; then
    load_enrollment_pk_fingerprints "$backup_id" || {
      fail "The current Secure Boot enrollment plan is invalid"
      return 1
    }
    echo "  Enrollment plan: $(firmware_plan_path "$backup_id")"
    echo "  Current PK SHA-256: ${_enrollment_current_pk_hash}"
    echo "  Planned PK SHA-256: ${_enrollment_planned_pk_hash}"
    gum confirm "Replace the current PK with the planned OmaSecBoot PK?" || return 1
    gum confirm "Confirm this firmware can delete only PK without clearing KEK, db, or dbx?" \
      || return 1
    gum confirm "Confirm retained trust entries and recovery preparation were reviewed?" \
      || return 1
    activate_confirmed_enrollment_plan "$backup_id" true true true || return 1
    repair_required=false
  fi
  if [[ "$repair_required" == true ]]; then
    run_artifact_repair sign || return 1
  fi
  state=$(observe_setup_state "$backup_id") || return 1
  case "$state" in
    2)
      warn "Setup Mode is active; run sudo omasecboot enroll"
      ;;
    3)
      validate_setup_instruction_boundary "$backup_id" 3 || return 1
      warn "Boot artifacts are proved. In firmware settings, delete only PK to enter Setup Mode."
      warn "Do not clear KEK, db, or dbx; then run sudo omasecboot enroll."
      ;;
    4)
      validate_setup_instruction_boundary "$backup_id" 4 || return 1
      warn "Enrollment is proved with Secure Boot off; enable Secure Boot in firmware settings."
      ;;
    5)
      pass "Secure Boot enrollment is active and matches the confirmed plan"
      ;;
    *)
      fail "Setup reached unsupported state ${state}"
      return 1
      ;;
  esac
}

cmd_enroll() {
  local backup_id state
  [[ $# -eq 0 ]] || {
    fail "Enrollment does not accept arguments"
    return 2
  }
  header "Key Enrollment"
  lifecycle_repair_is_available || {
    fail "Enrollment is blocked until recoverable Secure Boot commands are enabled"
    return 1
  }
  check_root "enroll"
  check_recovery_deps
  recover_lifecycle_if_required || {
    fail "Lifecycle recovery failed; no new firmware mutation was attempted"
    return 1
  }
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run enroll again to start a new enrollment"
    return 0
  fi
  check_deps
  check_efi_mode
  require_gum
  backup_id=$(current_setup_backup_id) || {
    fail "No current confirmed Secure Boot enrollment plan is available"
    return 1
  }
  state=$(observe_setup_state "$backup_id") || return 1
  if [[ "$state" == 4 || "$state" == 5 ]]; then
    pass "The confirmed Secure Boot trust plan is already enrolled"
    return 0
  fi
  [[ "$state" == 2 ]] || {
    fail "Enrollment requires validated Setup Mode; current setup state is ${state}"
    return 1
  }
  gum confirm "Enroll the confirmed db, KEK, and PK trust plan now?" || return 1
  run_dormant_enrollment "$backup_id" || return 1
  validate_setup_instruction_boundary "$backup_id" 4 || return 1
  warn "Enrollment is proved; enable Secure Boot in firmware settings."
}

observed_limine_setting() {
  local key="$1" value
  [[ -f "$LIMINE_DEFAULT_CONF" ]] || return 1
  load_limine_default_entry "$key" || return 1
  [[ ${_limine_default_count:-0} -le 1 ]] || return 1
  if [[ ${_limine_default_count:-0} -eq 0 ]]; then
    printf 'unset\n'
    return 0
  fi
  value=${_limine_default_raw:-}
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value=${value:1:${#value}-2}
  fi
  printf '%s\n' "$value"
}

observed_limine_token() {
  local key="$1" token="$2" value
  [[ -f "$LIMINE_DEFAULT_CONF" ]] || return 1
  load_limine_default_entry "$key" || return 1
  [[ ${_limine_default_count:-0} -le 1 ]] || return 1
  value=${_limine_default_raw:-}
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value=${value:1:${#value}-2}
  fi
  if [[ " $value " == *" $token "* ]]; then
    printf 'present\n'
  else
    printf 'absent\n'
  fi
}

verify_adoption_observations() {
  local expected_verification="$1" expected_enrollment="$3"
  local expected_before_save="$5" expected_after_save="$7"
  [[ "$(observed_limine_setting "ENABLE_VERIFICATION")" == \
    "$expected_verification" ]] || return 1
  [[ "$(observed_limine_setting "ENABLE_ENROLL_LIMINE_CONFIG")" == \
    "$expected_enrollment" ]] || return 1
  [[ "$(observed_limine_token "COMMANDS_BEFORE_SAVE" "limine-reset-enroll")" == \
    "$expected_before_save" ]] || return 1
  [[ "$(observed_limine_token "COMMANDS_AFTER_SAVE" "limine-enroll-config")" == \
    "$expected_after_save" ]] || return 1
}

cmd_adopt() {
  local original_verification="" original_enrollment=""
  local original_before_save="" original_after_save=""
  local observed_verification observed_enrollment
  local observed_before_save observed_after_save

  header "Adopt Existing Configuration"
  lifecycle_repair_is_available || {
    fail "Adoption is blocked until interrupted recovery is available"
    return 1
  }

  while (( $# > 0 )); do
    case "$1" in
      --verification-original)
        [[ $# -ge 2 ]] || die "Missing value for --verification-original"
        original_verification="$2"
        shift 2
        ;;
      --enrollment-original)
        [[ $# -ge 2 ]] || die "Missing value for --enrollment-original"
        original_enrollment="$2"
        shift 2
        ;;
      --before-save-original)
        [[ $# -ge 2 ]] || die "Missing value for --before-save-original"
        original_before_save="$2"
        shift 2
        ;;
      --after-save-original)
        [[ $# -ge 2 ]] || die "Missing value for --after-save-original"
        original_after_save="$2"
        shift 2
        ;;
      *)
        die "Unknown adoption option: $1"
        ;;
    esac
  done

  check_root "adopt"
  check_recovery_deps
  recover_lifecycle_if_required \
    || die "Lifecycle recovery failed; adoption was not attempted"
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run adopt again to start a new adoption"
    return 0
  fi
  read_lifecycle || die "Lifecycle state is invalid or unsafe"
  # shellcheck disable=SC2154 # Set by read_lifecycle from the sourced module.
  [[ "$_lifecycle_state" == unmanaged ]] \
    || die "Adoption requires unmanaged state; current state is ${_lifecycle_state}"

  observed_verification=$(observed_limine_setting "ENABLE_VERIFICATION") \
    || die "Could not read a unique ENABLE_VERIFICATION value from ${LIMINE_DEFAULT_CONF}"
  observed_enrollment=$(observed_limine_setting "ENABLE_ENROLL_LIMINE_CONFIG") \
    || die "Could not read a unique ENABLE_ENROLL_LIMINE_CONFIG value from ${LIMINE_DEFAULT_CONF}"
  observed_before_save=$(observed_limine_token \
    "COMMANDS_BEFORE_SAVE" "limine-reset-enroll") \
    || die "Could not read a unique COMMANDS_BEFORE_SAVE value from ${LIMINE_DEFAULT_CONF}"
  observed_after_save=$(observed_limine_token \
    "COMMANDS_AFTER_SAVE" "limine-enroll-config") \
    || die "Could not read a unique COMMANDS_AFTER_SAVE value from ${LIMINE_DEFAULT_CONF}"

  echo "  Existing managed settings:"
  echo "    ENABLE_VERIFICATION=${observed_verification}"
  echo "    ENABLE_ENROLL_LIMINE_CONFIG=${observed_enrollment}"
  echo "    COMMANDS_BEFORE_SAVE contains limine-reset-enroll: ${observed_before_save}"
  echo "    COMMANDS_AFTER_SAVE contains limine-enroll-config: ${observed_after_save}"
  echo
  warn "Choose unknown when the value before OmaSecBoot cannot be confirmed"

  if [[ -z "$original_verification" || -z "$original_enrollment" \
    || -z "$original_before_save" || -z "$original_after_save" ]]; then
    require_gum
  fi
  if [[ -z "$original_verification" ]]; then
    original_verification=$(gum choose --header \
      "Original ENABLE_VERIFICATION value" yes no unset unknown) || return 1
  fi
  if [[ -z "$original_enrollment" ]]; then
    original_enrollment=$(gum choose --header \
      "Original ENABLE_ENROLL_LIMINE_CONFIG value" yes no unset unknown) || return 1
  fi
  if [[ -z "$original_before_save" ]]; then
    original_before_save=$(gum choose --header \
      "Was limine-reset-enroll originally in COMMANDS_BEFORE_SAVE?" \
      present absent unknown) || return 1
  fi
  if [[ -z "$original_after_save" ]]; then
    original_after_save=$(gum choose --header \
      "Was limine-enroll-config originally in COMMANDS_AFTER_SAVE?" \
      present absent unknown) || return 1
  fi

  adopt_lifecycle verify_adoption_observations \
    "$observed_verification" "$original_verification" \
    "$observed_enrollment" "$original_enrollment" \
    "$observed_before_save" "$original_before_save" \
    "$observed_after_save" "$original_after_save" \
    || die "Could not commit the adoption record"
  pass "Existing configuration adopted; boot producers remain blocked until recovery is available"
}

cmd_windows_help() {
  header "Windows Dual-Boot"
  echo -e "  ${BOLD}Usage${NC}   sudo omasecboot windows <command>"
  echo
  echo -e "  ${BOLD}Commands${NC}"
  echo "    available   Check for Windows Boot Manager without root or output"
  echo "    preflight   Run the read-only Windows encryption preparation gate"
  echo "    setup       Blocked until recoverable commands are activated"
  echo "    suppress    Blocked until recoverable commands are activated"
  echo "    bootnext    Blocked until recoverable commands are activated"
  echo
}

cmd_windows_preflight() {
  header "Windows Encryption Preflight"
  check_root "windows preflight"
  windows_encryption_gate
}

cmd_windows() {
  if (( $# > 1 )); then
    cmd_windows_help
    fail "Expected one Windows command"
    return 1
  fi

  case "${1:-}" in
    available)
      find_windows_boot_entry >/dev/null
      ;;
    preflight)
      cmd_windows_preflight
      ;;
    setup)
      lifecycle_repair_is_available || {
        fail "Windows setup is blocked until recoverable Secure Boot commands are enabled"
        return 1
      }
      check_root "windows setup"
      check_recovery_deps
      recover_lifecycle_if_required || return 1
      if [[ "$_lifecycle_recovery_performed" == true ]]; then
        pass "Lifecycle recovery completed; run windows setup again for a new mutation"
        return 0
      fi
      check_deps
      check_efi_mode
      add_windows_boot_entry
      ;;
    suppress)
      lifecycle_repair_is_available || {
        fail "Windows suppression is blocked until recoverable Secure Boot commands are enabled"
        return 1
      }
      check_root "windows suppress"
      check_recovery_deps
      recover_lifecycle_if_required || return 1
      if [[ "$_lifecycle_recovery_performed" == true ]]; then
        pass "Lifecycle recovery completed; run windows suppress again for a new mutation"
        return 0
      fi
      check_deps
      check_efi_mode
      suppress_stale_windows_entry
      ;;
    bootnext)
      lifecycle_repair_is_available || {
        fail "BootNext is blocked until recoverable Secure Boot commands are enabled"
        return 1
      }
      check_root "windows bootnext"
      check_recovery_deps
      recover_lifecycle_if_required || return 1
      if [[ "$_lifecycle_recovery_performed" == true ]]; then
        pass "Lifecycle recovery completed; BootNext was not armed again"
        return 0
      fi
      check_core_deps
      check_efi_mode
      run_dormant_windows_bootnext
      ;;
    help|--help|-h)
      cmd_windows_help
      ;;
    "")
      cmd_windows_help
      return 1
      ;;
    *)
      cmd_windows_help
      fail "Unknown Windows command: $1"
      return 1
      ;;
  esac
}

cmd_cleanup() {
  [[ $# -eq 0 ]] || {
    fail "Cleanup does not accept arguments"
    return 2
  }
  lifecycle_repair_is_available || {
    fail "Cleanup is blocked until recoverable Secure Boot commands are enabled"
    return 1
  }
  check_root "cleanup"
  check_recovery_deps
  recover_lifecycle_if_required || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run cleanup again for a new cleanup mutation"
    return 0
  fi
  check_core_deps
  run_tracking_cleanup cleanup
}

cmd_sign() {
  [[ $# -eq 0 ]] || {
    fail "Signing does not accept arguments"
    return 2
  }
  lifecycle_repair_is_available || {
    fail "Signing is blocked until recoverable Secure Boot commands are enabled"
    return 1
  }
  check_root "sign"
  check_recovery_deps
  recover_lifecycle_if_required || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; run sign again for a new signing mutation"
    return 0
  fi
  check_deps
  qheader "Signing EFI Files"
  run_artifact_repair sign
}

cmd_unconfigure() {
  [[ $# -eq 0 ]] || {
    fail "Unconfigure does not accept arguments"
    return 2
  }
  header "Disable OmaSecBoot Management"
  lifecycle_repair_is_available || {
    fail "Unconfiguration is blocked until recoverable Secure Boot commands are enabled"
    return 1
  }
  check_root "unconfigure"
  check_recovery_deps
  recover_lifecycle_if_required || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed; no new unconfiguration was started"
    return 0
  fi
  check_deps
  require_gum
  gum confirm "Restore recorded defaults and rebuild stock Limine boot state?" || return 1
  run_dormant_unconfigure
}

cmd_repair() {
  [[ $# -eq 0 ]] || {
    fail "Repair does not accept arguments"
    return 2
  }
  header "Lifecycle Recovery"
  lifecycle_repair_is_available || {
    fail "Recovery is blocked until recoverable Secure Boot commands are enabled"
    return 1
  }
  check_root "repair"
  check_recovery_deps
  recover_lifecycle_if_required || return 1
  if [[ "$_lifecycle_recovery_performed" == true ]]; then
    pass "Lifecycle recovery completed"
  else
    pass "No lifecycle recovery is required"
  fi
}

cmd_status() {
  local lifecycle_rc=0 status_rc=0
  [[ $# -eq 0 ]] || return 2
  check_core_deps
  show_lifecycle_status || lifecycle_rc=$?
  show_status || status_rc=$?
  [[ $lifecycle_rc -eq 0 && $status_rc -eq 0 ]]
}

cmd_version() {
  [[ $# -eq 0 ]] || return 2
  printf 'omasecboot %s\n' "$OMASECBOOT_VERSION"
}

cmd_hook() {
  [[ $# -eq 1 ]] || return 2
  case "$1" in
    pre) producer_limine_hook_pre ;;
    post) producer_limine_hook_post ;;
    package-cleanup) producer_package_checkpoint ;;
    package-sign) producer_package_post ;;
    *) return 2 ;;
  esac
}

cmd_guard() {
  local rc=0
  [[ $# -eq 1 ]] || return 2
  case "$1" in
    transaction)
      producer_package_pre
      ;;
    removal)
      require_control_root || return 1
      with_boot_repair_lock || return 1
      if ! lifecycle_removal_is_allowed; then
        fail "Package removal requires verified disabled or pristine lifecycle state"
        rc=1
      fi
      release_boot_repair_lock
      return "$rc"
      ;;
    *) return 2 ;;
  esac
}

cmd_help() {
  [[ $# -eq 0 ]] || return 2
  header "Command Help"
  echo "  Secure Boot signing, Limine enrollment, pacman hooks, and Windows BootNext handoff for Omarchy."
  echo "  Artifact proof is implemented; mutation remains blocked until recovery is available."
  echo
  echo -e "  ${BOLD}Usage${NC}   sudo omasecboot <command>"
  echo
  echo -e "  ${BOLD}Commands${NC}"
  echo "    setup       Blocked until recoverable commands are activated"
  echo "    adopt       Blocked until recoverable commands are activated"
  echo "    enroll      Blocked until recoverable commands are activated"
  echo "    windows     Probe Windows or run its read-only encryption preflight"
  echo "    status      Show Secure Boot status and file verification"
  echo "    sign        Blocked until recoverable commands are activated"
  echo "    cleanup     Blocked until recoverable commands are activated"
  echo "    unconfigure Blocked until recoverable commands are activated"
  echo "    repair      Blocked until recoverable commands are activated"
  echo "    version     Show the installed OmaSecBoot version"
  echo "    help        Show this help"
  echo
  echo -e "  ${DIM}Safety:${NC} Do not change firmware keys from this implementation state."
  echo
}

# --- Dispatch ----------------------------------------------------------------

main() {
  # Parse global flags
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --quiet) QUIET=true; export QUIET; shift ;;
      *)       break ;;
    esac
  done

  case "${1:-}" in
    setup)    shift; cmd_setup "$@" ;;
    adopt)    shift; cmd_adopt "$@" ;;
    enroll)   shift; cmd_enroll "$@" ;;
    windows)  shift; cmd_windows "$@" ;;
    cleanup)  shift; cmd_cleanup "$@" ;;
    sign)     shift; cmd_sign "$@" ;;
    unconfigure) shift; cmd_unconfigure "$@" ;;
    repair)   shift; cmd_repair "$@" ;;
    status)   shift; cmd_status "$@" ;;
    version|--version|-v) shift; cmd_version "$@" ;;
    hook)     shift; cmd_hook "$@" ;;
    guard)    shift; cmd_guard "$@" ;;
    help|--help|-h)  shift; cmd_help "$@" ;;
    *)
      cmd_help
      if [[ -n "${1:-}" ]]; then
        fail "Unknown command: $1"
        echo
      fi
      return 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
