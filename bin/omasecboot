#!/bin/bash
# OmaSecBoot: Secure Boot for Omarchy with the user's own keys. It delegates to
# sbctl and the Limine tools, verifies what they did and reports the truth.
# Design: docs/spec.md. Upstream behaviour relied on: docs/upstream-contracts.md.
set -euo pipefail

# /usr/bin/omasecboot runs with /usr/lib/omasecboot; a checkout runs with lib/.
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
LIB_DIR=${SCRIPT_DIR}/../lib/omasecboot
[[ -d $LIB_DIR ]] || LIB_DIR=${SCRIPT_DIR}/../lib

for module in common checks files firmware limine windows sign status; do
  # shellcheck source=/dev/null
  source "${LIB_DIR}/${module}.sh"
done

usage() {
  print_message "${BOLD}omasecboot${NC} ${OMASECBOOT_VERSION}: Secure Boot for Omarchy with your own keys

  ${BOLD}sudo omasecboot setup${NC}         Prepare this machine; run it again after each step it asks for
  ${BOLD}sudo omasecboot status${NC}        Report the state and the next step (--quiet: exit status only)
  ${BOLD}sudo omasecboot sign${NC}          Seal and sign the boot files again; safe to run at any time
  ${BOLD}sudo omasecboot remove${NC}        Return the boot files and Limine settings to stock
  ${BOLD}omasecboot windows preflight${NC}  Look for Windows and BitLocker, and say what to do before Secure Boot changes
  ${BOLD}sudo omasecboot windows setup${NC}     Add a Windows entry to the boot menu     (${BOLD}windows remove${NC} takes it out)
  ${BOLD}sudo omasecboot windows bootnext${NC}  Ask the firmware to start Windows at the next boot, once
  ${BOLD}sudo omasecboot windows status${NC}    Show the Windows target and the entry's state
  ${BOLD}omasecboot version${NC}

  ${BOLD}--quiet${NC} anywhere on the line keeps progress quiet; warnings and failures still print"
}

# Commands take no arguments beyond the ones they name.
no_arguments() {
  (( $# == 0 )) || {
    usage >&2
    exit 2
  }
}

# Everything that must hold before anything on the machine changes.
setup_preflight() {
  local leftovers shadows
  check_architecture && check_uefi && check_esp && check_tools || return 1
  # remove refuses without a readable SecureBoot variable, so a machine that
  # cannot be undone is not set up in the first place.
  { read_mode_variable SecureBoot && read_mode_variable SetupMode; } >/dev/null || {
    fail "Could not read the firmware's SecureBoot and SetupMode variables"
    return 1
  }
  leftovers=$(list_leftovers)
  if [[ -n $leftovers ]]; then
    fail "An earlier install of this tool is still present and would keep running its own hooks:"
    print_message "$leftovers" >&2
    act "Remove it with: ${BOLD}sudo rm -rf ${leftovers//$'\n'/ }${NC}"
    return 1
  fi
  shadows=$(list_shadowing_configs)
  if [[ -n $shadows ]]; then
    fail "Limine would read another limine.conf before $(limine_config_path):"
    print_message "$shadows" >&2
    return 1
  fi
  # Entries without a UKI need path hashes under Secure Boot, which the
  # managed settings turn off; Omarchy ships UKIs.
  [[ $(effective_setting ENABLE_UKI) == yes ]] || {
    fail "ENABLE_UKI is not yes; OmaSecBoot supports unified kernel images only"
    return 1
  }
}

# print_entries ROWS: "NAME entry" rows, each as a line a person can act on.
print_entries() {
  local name type owner digest
  while read -r name type owner digest; do
    [[ -z $name ]] || print_message "      ${name}: $(describe_entry "$type" "$owner" "$digest")" >&2
  done <<<"$1"
}

# Setup Mode: write the local keys. The proof is made against the backup taken
# while a PK was in place; a machine that reached Setup Mode before its first
# setup has only a backup of what was left, and is told so.
setup_enrollment() {
  local backup path lost question name
  [[ $(read_mode_variable SetupMode) == 1 ]] || die "The firmware has no Platform Key but does not report Setup Mode; nothing was written"
  if ! backup=$(reference_backup); then
    backup=$(latest_firmware_backup) || backup=$(take_firmware_backup) || die "Could not back up the firmware's key variables"
    warn "The only backup was taken in Setup Mode, so this tool cannot tell what the firmware's key menu removed"
  fi
  lost=$(list_lost_entries "$backup" current) || die "Could not compare the firmware's keys with the backup ${backup}"
  if append_is_safe "$backup"; then
    path=append
  elif read_rebuild_plan && rebuild_applies; then
    path=rebuild
  else
    path=refuse
  fi

  case $path in
    append)
      append_plan_is_sound || die "sbctl's plan is not the firmware's entries plus your certificates; nothing was written"
      note "Your certificates join the $(count_foreign_entries) KEK and db entries the firmware holds; nothing is removed"
      question="Write your keys to the firmware? The Platform Key becomes yours."
      ;;
    rebuild)
      rebuild_plan_is_sound || die "sbctl's rebuild plan does not hold your certificates; nothing was written"
      lost=$(list_lost_entries "$backup" planned) || die "Could not compare the rebuild plan with the backup ${backup}"
      warn "The firmware's key menu cleared KEK and db together with the Platform Key. sbctl can put back $(describe_rebuild_sources)."
      if [[ -n $lost ]]; then
        warn "These entries of the backup cannot be put back and will no longer be trusted:"
        print_entries "$lost"
      fi
      dbx_equals_backup "$backup" ||
        warn "The revocation list (dbx) differs from the backup. This tool never writes it; a firmware update or fwupd restores it."
      question="Rebuild KEK and db as described above, and write your keys to the firmware?"
      ;;
    refuse)
      fail "The firmware's keys are in a state this tool will not write to:"
      print_entries "$lost"
      for name in KEK db; do
        [[ -n $(foreign_entries "$name") ]] || print_message "      ${name} holds no entries besides yours, while the other list was kept" >&2
      done
      dbx_equals_backup "$backup" || print_message "      The revocation list (dbx) differs from the backup" >&2
      die "Restore the factory keys in the firmware, run ${BOLD}sudo omasecboot setup${NC}, then delete only the Platform Key (PK)."
      ;;
  esac

  note "The backup of the keys this machine trusted is in ${backup}"
  acknowledge_windows_encryption || exit 1
  confirm "the key enrollment" "$question" || exit 1
  enroll_local_keys "$path" || die "The enrollment stopped. The firmware stays in Setup Mode; run ${BOLD}sudo omasecboot setup${NC} again."
  { read_enrollment_plan && firmware_is_enrolled; } || die "The firmware does not hold your keys after the write; run ${BOLD}sudo omasecboot setup${NC} again."
  pass "Your keys are enrolled"
  act "Reboot, then run ${BOLD}sudo omasecboot setup${NC} once more"
}

# The firmware half of setup: one step per run, chosen from what the firmware
# holds. first_run: this invocation created the "enabled" marker, so it ends
# with an instruction and leaves any firmware write to the next one.
setup_firmware_step() {
  local first_run=$1 backup
  read_enrollment_plan || die "Could not ask sbctl what an enrollment would write"
  # Everything after this rests on knowing the local certificates, so it is
  # settled before the user is asked to delete anything.
  local_certificates_are_identified || die "sbctl's export does not show exactly one certificate of yours for each of db, KEK and PK"
  if firmware_is_enrolled; then
    # SetupMode keeps reading 1 in the boot that wrote the PK (C6).
    if [[ $(read_mode_variable SetupMode) == 1 ]]; then
      act "Your keys are enrolled. Reboot, then run ${BOLD}sudo omasecboot setup${NC} once more"
    elif [[ $(read_mode_variable SecureBoot) == 1 ]]; then
      pass "Secure Boot is on with your keys. Setup is complete."
    else
      pass "Your keys are enrolled and every boot file is proved"
      remind_of_windows_encryption
      act "Reboot into the firmware and turn Secure Boot on"
    fi
  elif platform_key_is_present; then
    backup=$(take_firmware_backup) || die "Could not back up the firmware's key variables"
    note "The keys this machine trusts now are backed up in ${backup}"
    # Deleting the PK already changes what Windows measures at boot.
    acknowledge_windows_encryption || exit 1
    act "Reboot into the firmware and delete only the Platform Key (PK); keep KEK, db and dbx. Some firmware shows its key menu only while Secure Boot is set to enabled."
    act "Then run ${BOLD}sudo omasecboot setup${NC} again"
  elif [[ $first_run == true ]]; then
    reference_backup >/dev/null || take_firmware_backup >/dev/null || die "Could not back up the firmware's key variables"
    act "The firmware is in Setup Mode. Run ${BOLD}sudo omasecboot setup${NC} again to enroll your keys"
  else
    setup_enrollment
  fi
}

cmd_setup() {
  local first_run=true
  no_arguments "$@"
  check_root setup
  header "Setup"
  setup_preflight || exit 1
  require_terminal || exit 1
  # A full snapshot restore works on the boot files without the lock (C2).
  ! restore_in_progress || die "A snapshot restore is running; run this again when it has finished"
  ! is_set_up || first_run=false

  if sbctl_keys_exist; then
    pass "Signing keys exist"
  else
    # sbctl creates its own directories and writes nothing when they exist.
    act "Creating signing keys with sbctl"
    sbctl create-keys || die "sbctl could not create the keys"
  fi
  # sbctl arrived as a dependency; as an orphan candidate Omarchy's cleanup
  # would offer to remove it, and the next kernel would boot unsigned.
  pacman -D --asexplicit sbctl >/dev/null || warn "Could not mark sbctl as explicitly installed"

  save_settings_originals || die "Could not record the original Limine settings"
  remove_harmful_sbctl_rows || exit 1
  boot_lock_acquire || exit "$?"
  apply_managed_settings || die "Could not write $(limine_default_config)"
  # From here on the Limine hook keeps the boot files converged, and enables
  # the watchers, also when this run is interrupted.
  ensure_state_dir || die "Unsafe state directory $(state_dir)"
  : >"$(enabled_marker)"
  if os_entries_carry_hashes; then
    regenerate_os_entries || die "The boot entries could not be regenerated without path hashes; run this again"
  fi
  boot_lock_release
  sign_boot_files || exit "$?"

  pass "This machine's boot files are ready for Secure Boot"
  [[ $(fallback_state) != absent ]] ||
    warn "There is no fallback loader. After a limine.conf mistake only rescue media could boot this machine; ${BOLD}sudo limine-install --fallback${NC} adds one."
  [[ $first_run == false ]] ||
    act "Take a snapshot now, so a later restore brings the keys and this tool back with it"
  setup_firmware_step "$first_run"
}

cmd_sign() {
  local scope=full
  if [[ ${1:-} == --seal-only ]]; then
    scope=seal-only
    shift
    # The watchers' pass takes a second or two and must not be cut off half
    # way by the shutdown that follows an update: the machine would start a
    # loader the firmware refuses. The service's KillMode leaves the tools it
    # runs alone as well.
    trap '' TERM
  fi
  no_arguments "$@"
  check_root sign
  is_set_up || die "OmaSecBoot is not set up. Run: ${BOLD}sudo omasecboot setup${NC}"
  qheader "Sign"
  sign_boot_files "$scope"
}

cmd_status() {
  no_arguments "$@"
  check_root status
  if [[ $QUIET == true ]]; then
    show_status >/dev/null 2>&1
  else
    show_status
  fi
}

# Re-runnable: the originals file drives it and is removed last, so a second
# run after an interruption picks up where the first stopped.
cmd_remove() {
  local secure_boot
  no_arguments "$@"
  check_root remove
  header "Remove"
  [[ -e $(settings_originals_file) ]] || die "Nothing to remove: OmaSecBoot is not set up"
  check_uefi && check_esp && check_tools || exit 1
  # The stock boot files are unsigned, so an unreadable variable is no answer.
  secure_boot=$(read_mode_variable SecureBoot) || die "Could not read the firmware's SecureBoot variable"
  [[ $secure_boot == 0 ]] || die "Secure Boot is on. Turn it off in the firmware first: the stock boot files are unsigned."
  ! restore_in_progress || die "A snapshot restore is running; run this again when it has finished"
  confirm "returning to stock boot files" "Return the Limine settings and boot files to stock?" || exit 1

  # The lock comes first: a busy lock must leave the hook and the watchers at
  # work on a loader that is still sealed.
  boot_lock_acquire || exit "$?"
  rm -f -- "$(enabled_marker)"
  disable_watch || warn "Could not disable the watchers"
  restore_settings_originals || die "Could not restore $(limine_default_config)"
  restore_stock_boot_files || die "The boot files are not back to stock; run this again"
  # Only now: the loader is proved raw, so limine.conf may change under it.
  write_windows_entry || die "Could not take the Windows entry out of $(limine_config_path); run this again"
  rm -f -- "$(windows_flag)"
  boot_lock_release
  clear_attention
  rm -f -- "$(settings_originals_file)"
  pass "Limine settings and boot files are back to stock"
  note "Your signing keys stay in /var/lib/sbctl. Firmware keys are restored in the firmware's own key menu."
}

# The menu entry's guard: unprivileged and silent. The opt-in exists and the
# firmware still has one clear target.
windows_is_available() {
  { [[ -e $(windows_flag) ]] && resolve_windows_target; } >/dev/null 2>&1 || return 1
}

cmd_windows() {
  local action=${1:-} state status=0 checksum
  (( $# == 0 )) || shift
  no_arguments "$@"
  case $action in
    available)
      windows_is_available
      ;;
    preflight)
      header "Windows preflight"
      state=$(windows_encryption_state)
      case $state in
        absent) pass "No Windows Boot Manager entry and no BitLocker volume were found. That is an observation, not a clearance of the firmware." ;;
        present) print_encryption_guidance "$(list_bitlocker_volumes)" ;;
        unknown)
          fail "Could not tell whether Windows or a BitLocker volume is on this machine"
          print_encryption_guidance ''
          ;;
      esac
      [[ $state != unknown ]]
      ;;
    status)
      header "Windows"
      resolve_windows_target || status=$?
      case $status in
        0)
          pass "Target: Boot$(windows_target_number), $(windows_target_label)"
          note "The entry in limine.conf is $(windows_entry_state "$(windows_target_label)")"
          ;;
        1) note "The firmware has no single active Windows Boot Manager entry with a name of its own" ;;
        *) fail "Could not read the firmware's boot entries" ;;
      esac
      if [[ -e $(windows_flag) ]]; then note "The Windows entry is enabled"; else note "The Windows entry is not enabled"; fi
      ;;
    setup)
      check_root "windows setup"
      header "Windows entry"
      is_set_up || die "OmaSecBoot is not set up. Run: ${BOLD}sudo omasecboot setup${NC}"
      check_uefi && check_esp || exit 1
      ! restore_in_progress || die "A snapshot restore is running; run this again when it has finished"
      resolve_windows_target || status=$?
      case $status in
        0) ;;
        1) die "The firmware has no single active Windows Boot Manager entry with a name of its own; this tool never creates or renames firmware entries" ;;
        *) die "Could not read the firmware's boot entries" ;;
      esac
      # The lock first, so a busy lock changes nothing; the pass below keeps it,
      # writes the entry and seals the loader over it.
      boot_lock_acquire || exit "$?"
      ensure_state_dir || die "Unsafe state directory $(state_dir)"
      : >"$(windows_flag)"
      sign_boot_files || exit "$?"
      [[ $(windows_entry_state "$(windows_target_label)") == current ]] ||
        die "The Windows entry did not reach limine.conf. It stays enabled, and the next pass writes it; see: sudo omasecboot status"
      pass "Windows is in the boot menu: the entry restarts the machine into $(windows_target_label)"
      ;;
    remove)
      check_root "windows remove"
      header "Windows entry"
      check_esp || exit 1
      ! restore_in_progress || die "A snapshot restore is running; run this again when it has finished"
      boot_lock_acquire || exit "$?"
      if is_set_up; then
        # The pass takes the entry out, because the flag is gone, and seals
        # the loader over the result.
        rm -f -- "$(windows_flag)"
        sign_boot_files || exit "$?"
      else
        # No pass will seal the loader, so limine.conf may only change while
        # the loader carries no checksum at all.
        { checksum=$(embedded_checksum "$(primary_loader_path)") && checksum_is_zero "$checksum"; } ||
          die "The Limine loader is sealed over the current limine.conf, or cannot be read, and nothing would seal it again. Run ${BOLD}sudo omasecboot remove${NC} or ${BOLD}sudo omasecboot setup${NC} first."
        write_windows_entry || die "Could not take the Windows entry out of $(limine_config_path)"
        rm -f -- "$(windows_flag)"
        boot_lock_release
      fi
      [[ $(windows_entry_state '') == absent ]] || die "The Windows entry is still in limine.conf"
      pass "The Windows entry is gone"
      ;;
    bootnext)
      check_root "windows bootnext"
      check_uefi || exit 1
      command -v efibootmgr >/dev/null 2>&1 || die "efibootmgr is not installed"
      resolve_windows_target || status=$?
      case $status in
        0) ;;
        1) die "The firmware has no single active Windows Boot Manager entry with a name of its own; no request was made" ;;
        *) die "Could not read the firmware's boot entries; no request was made" ;;
      esac
      request_windows_boot || die "BootNext does not read back as the Windows entry; check with: efibootmgr"
      qpass "The firmware holds the request to start $(windows_target_label) at the next boot, once"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main() {
  local argument command
  local -a arguments=()
  for argument in "$@"; do
    if [[ $argument == --quiet ]]; then
      QUIET=true
    else
      arguments+=("$argument")
    fi
  done
  set -- "${arguments[@]}"
  command=${1:-help}
  (( $# == 0 )) || shift
  case $command in
    setup) cmd_setup "$@" ;;
    sign) cmd_sign "$@" ;;
    status) cmd_status "$@" ;;
    remove) cmd_remove "$@" ;;
    windows) cmd_windows "$@" ;;
    version) print_message "omasecboot ${OMASECBOOT_VERSION}" ;;
    help | -h | --help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

# The test suites source this file for its command functions.
[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
