# OmaSecBoot: checkpoint the owned package producer before sbctl repair.
# Runs before zz-sbctl.hook so the durable producer lease records this boundary first.
# Mirrors zz-sbctl.hook's Path triggers to fire in the same transactions.

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = boot/*
Target = efi/*
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/extramodules/*
Target = usr/lib/**/efi/*.efi*
Target = usr/share/**/*.efi*

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/modules.builtin

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = linux*
Target = limine*
Target = snapper*
Target = mkinitcpio*
Target = sbctl
Target = omarchy
Target = omarchy-settings

[Action]
Description = Secure Boot: checkpoint package producer before sbctl
When = PostTransaction
Exec = @BINDIR@/omasecboot --quiet hook package-cleanup
