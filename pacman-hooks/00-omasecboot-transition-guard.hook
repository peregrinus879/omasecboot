# OmaSecBoot: block package producers unless lifecycle permits boot mutation.
# OmaSecBoot hook schema: 1

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = boot/*
Target = efi/*
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/extramodules/*
Target = usr/lib/**/efi/*.efi*
Target = usr/share/**/*.efi*

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/modules.builtin

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = linux*
Target = limine*
Target = snapper*
Target = mkinitcpio*
Target = sbctl
Target = efibootmgr
Target = coreutils
Target = omarchy
Target = omarchy-settings

[Action]
Description = Secure Boot: validate lifecycle before boot mutation
When = PreTransaction
Exec = @BINDIR@/omasecboot --quiet guard transaction
AbortOnFail
NeedsTargets
