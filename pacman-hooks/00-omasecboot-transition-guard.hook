# OmaSecBoot: block package producers unless lifecycle permits boot mutation.

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = boot/*
Target = efi/*
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/extramodules/*
Target = usr/lib/**/efi/*.efi*
Target = usr/share/**/*.efi*

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = linux*
Target = limine*
Target = snapper*
Target = mkinitcpio*

[Action]
Description = Secure Boot: validate lifecycle before boot mutation
When = PreTransaction
Exec = @BINDIR@/omasecboot --quiet guard transaction
AbortOnFail
