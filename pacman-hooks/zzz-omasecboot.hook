# OmaSecBoot: complete owned package-producer repair after sbctl runs.
# Runs after zz-sbctl.hook and Limine-related package updates.

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = linux*
Target = limine*
Target = snapper*
Target = mkinitcpio*
Target = sbctl
Target = efibootmgr
Target = coreutils
Target = omarchy
Target = omarchy-settings

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = boot/*
Target = efi/*
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/extramodules/*
Target = usr/lib/**/efi/*.efi*
Target = usr/share/**/*.efi*

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/modules.builtin

[Action]
Description = Secure Boot: complete package producer repair
When = PostTransaction
Exec = @BINDIR@/omasecboot --quiet hook package-sign
