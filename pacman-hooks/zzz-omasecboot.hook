# OmaSecBoot: checkpoint package-driven boot mutation after sbctl runs.
# Runs after zz-sbctl.hook and Limine-related package updates.

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = linux*
Target = limine*
Target = snapper*
Target = mkinitcpio*

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = boot/*
Target = efi/*
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/extramodules/*
Target = usr/lib/**/efi/*.efi*
Target = usr/share/**/*.efi*

[Action]
Description = Secure Boot: record package mutation after sbctl
When = PostTransaction
Exec = @BINDIR@/omasecboot --quiet hook package-sign
