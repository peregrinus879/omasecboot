# OmaSecBoot: preserve recovery dependencies while lifecycle state is managed.
# OmaSecBoot hook schema: 1

[Trigger]
Type = Package
Operation = Remove
Target = omasecboot
Target = bash
Target = coreutils
Target = diffutils
Target = findutils
Target = gawk
Target = grep
Target = util-linux
Target = systemd
Target = pacman
Target = jq
Target = openssl
Target = gum
Target = efibootmgr
Target = sbctl
Target = limine
Target = limine-mkinitcpio-hook
Target = limine-snapper-sync

[Action]
Description = Secure Boot: validate lifecycle before dependency removal
When = PreTransaction
Exec = @BINDIR@/omasecboot --quiet guard removal
AbortOnFail
