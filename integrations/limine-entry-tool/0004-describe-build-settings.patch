+# Pure shell configuration parsing and layer traversal. No initialization here.
+# Keep the original dynamically scoped loader names and literal export semantics.
+limine_config_assignment() {
+	export "$1"="$2"
+}
+
+# Observation callbacks are inert in mutation. The read-only interface supplies
+# fixed implementations; configuration never chooses an executable callback.
+limine_config_directory() { :; }
+limine_config_file() { :; }
+
+limine_parse_key_values() {
+	while IFS= read -r line || [[ -n "$line" ]]; do
+		[[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
+		if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
+			local var="${BASH_REMATCH[1]}"
+			local val="${BASH_REMATCH[2]}"
+			val="${val%\"}"
+			val="${val#\"}"
+			limine_config_assignment "$var" "$val"
+		fi
+	done
+}
+
+load_key_value_config() {
+	local file="$1"
+	limine_parse_key_values <"$file"
+}
+
+load_config_values() {
+	local usr_d_dir="/usr/share/limine-entry-tool.d"
+	local etc_conf="/etc/limine-entry-tool.conf"
+	local etc_d_dir="/etc/limine-entry-tool.d"
+	local default_conf="/etc/default/limine"
+
+	limine_config_directory "$usr_d_dir"
+	if [[ -d "$usr_d_dir" ]]; then
+		for file in "$usr_d_dir"/*.conf; do
+			limine_config_file "$file"
+			[[ -f "$file" ]] || continue
+			load_key_value_config "$file"
+		done
+	fi
+
+	limine_config_file "$etc_conf"
+	if [[ -f "$etc_conf" ]]; then
+		load_key_value_config "$etc_conf"
+	fi
+
+	limine_config_directory "$etc_d_dir"
+	if [[ -d "$etc_d_dir" ]]; then
+		for file in "$etc_d_dir"/*.conf; do
+			limine_config_file "$file"
+			[[ -f "$file" ]] || continue
+			load_key_value_config "$file"
+		done
+	fi
+
+	# shellcheck disable=SC2034 # Consumed by common-functions after loading.
+	ENABLE_ENROLL_LIMINE_CONFIG=""
+	limine_config_file "$default_conf"
+	if [[ -f "$default_conf" ]]; then
+		load_key_value_config "$default_conf"
+	fi
+	return 0
+}
