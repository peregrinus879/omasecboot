+    private static String blake2sum(String absoluteFilePath) throws IOException {
+        Output output = Utility.getCommandOutput(List.of(Config.HASH_COMMAND, "--",
+                Path.of(absoluteFilePath).toAbsolutePath().toString()), false, true);
+        if (!output.isSuccess() || output.text().size() != 1) {
+            throw new IOException("Failed to hash file: " + absoluteFilePath);
+        }
+        String hash = Utility.extractHash(output.text().getFirst());
+        // GNU b2sum prefixes escaped filenames with a backslash before the hash.
+        if (hash.startsWith("\\")) {
+            hash = hash.substring(1);
         }
+        if (!hash.matches("[0-9a-fA-F]{128}")) {
+            throw new IOException("Invalid BLAKE2 hash for file: " + absoluteFilePath);
+        }
+        return hash.toLowerCase(Locale.ROOT);
+    }
