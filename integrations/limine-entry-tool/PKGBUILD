    'f65870ae95fa0c2945d9e8c8610739bad018aea9515af548899c676c9bfc0642' \
    'README.md' |
    sha256sum --check --strict || return 1

  cd "$srcdir" || return 1
  [[ -d "${_graalvm_version}" ]] && rm -rf "${_graalvm_version}"
  mv graalvm-community-*/ "${_graalvm_version}"
  if ! command -v "${_graalvm_version}"/bin/javac >/dev/null 2>&1; then
    printf 'Error: %s/bin/javac not found.\n' "${_graalvm_version}" >&2
    return 1
  fi
}

build() {
  cd "$srcdir/${_source_dir}" || return 1
  export GRAALVM_HOME="$srcdir/${_graalvm_version}"
  export JAVA_HOME="${GRAALVM_HOME}"
  export NATIVE_IMAGE_OPTIONS="-march=compatibility --future-defaults=all"
  local gradle=/usr/bin/gradle
  [[ $CARCH == aarch64 ]] && gradle="$srcdir/gradle-${_gradle_version}/bin/gradle"
  "$gradle" clean nativeCompile -Dorg.gradle.java.home="${JAVA_HOME}"
}

package() {
  cd "$srcdir/${_source_dir}" || return 1
  local src="install/arch-linux"

  # directories
  install -dm 755 \
    "$pkgdir/usr/share/doc/limine-entry-tool" \
    "$pkgdir/etc/boot/hooks/pre.d" \
    "$pkgdir/etc/boot/hooks/post.d" \
    "$pkgdir/usr/lib/limine"

  # docs
  install -Dm 644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/limine-entry-tool/"

  # files
  cp -a "$src/limine-entry-tool/etc" "$src/limine-entry-tool/usr" "$pkgdir/"
  cp -a "$src/limine-mkinitcpio-hook/etc" "$src/limine-mkinitcpio-hook/usr" "$pkgdir/"
  install -Dm 755 "build/native/nativeCompile/limine-entry-tool" "$pkgdir/usr/lib/limine/"

  # limine hook symlinks
  ln -sf /usr/bin/limine-reset-enroll "$pkgdir/etc/boot/hooks/pre.d/10-limine-reset-enroll"
  ln -sf /usr/bin/limine-enroll-config "$pkgdir/etc/boot/hooks/post.d/90-limine-enroll-config"

  cd "$pkgdir" || return 1
  printf '%s  %s\n' \
    '3fe2631ba4f5ac8fc380fe9d63557c4f235ecfad5d4c5e123269bdeb27e97f01' \
    'usr/share/libalpm/scripts/limine-mkinitcpio-install' \
    '7e369e43dfc66c0cfe479792f6d6079d665b1d42a6e2ae1a173030909ed26e31' \
    'usr/lib/limine/limine-common-functions' \
    '90d05f47ae2ecb4a9996c7ea70c8645b4514eef912d6e3759f9f9b3c4fed2e99' \
    'usr/bin/limine-mkinitcpio' \
    '7402fb5df3ea6422a79b7b9b7550c8c842b161fd1fa0f4b378f7b624973cf6e2' \
    'usr/bin/limine-entry-tool' \
    'f65870ae95fa0c2945d9e8c8610739bad018aea9515af548899c676c9bfc0642' \
    'usr/share/doc/limine-entry-tool/README.md' |
    sha256sum --check --strict
}
