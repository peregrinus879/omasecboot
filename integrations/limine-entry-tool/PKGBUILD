    '7e369e43dfc66c0cfe479792f6d6079d665b1d42a6e2ae1a173030909ed26e31' \
    'install/arch-linux/limine-entry-tool/usr/lib/limine/limine-common-functions' \
    '90d05f47ae2ecb4a9996c7ea70c8645b4514eef912d6e3759f9f9b3c4fed2e99' \
    'install/arch-linux/limine-mkinitcpio-hook/usr/bin/limine-mkinitcpio' \
    'b0f7b89375b6b13fa82b4ade1e3900cd51180002ec012704c4bafa2c67040e7f' \
    'src/main/java/org/limine/entry/tool/Main.java' \
    '28c90ed866dfa327ae5589b027d6bc6eda75775181dda0bc45d283ac131cee03' \
    'src/main/java/org/limine/entry/tool/processes/LimineManager.java' \
    '7b16e7c7db0a2097d4effbfcc302fd2eeed4df90c5730588f2930ba107617953' \
    'src/main/java/org/limine/entry/tool/processes/LimineWriter.java' \
    '2b4b2f03f5362e4fdeb9cb40f8cab8ac41bef10c780397bde87832d1c92ac4c7' \
    'src/main/java/org/limine/entry/tool/processes/Utility.java' |
    sha256sum --check --strict || return 1
  patch -Np1 --fuzz=0 --batch --forward -i "$srcdir/0001-propagate-mkinitcpio-failures.patch" || return 1
  patch -Np1 --fuzz=0 --batch --forward -i "$srcdir/0002-propagate-native-failures.patch" || return 1
  printf '%s  %s\n' \
    '3fe2631ba4f5ac8fc380fe9d63557c4f235ecfad5d4c5e123269bdeb27e97f01' \
    'install/arch-linux/limine-mkinitcpio-hook/usr/share/libalpm/scripts/limine-mkinitcpio-install' \
    '20b24e981c836b9487f207d5320df3664335ac24f19d711034b7f090bbe3ceef' \
    'src/main/java/org/limine/entry/tool/Main.java' \
    '53ee6350c210e166768757239495fab37d5d7261b1b4466cc6112463e8c87248' \
    'src/main/java/org/limine/entry/tool/processes/LimineManager.java' \
    'f69fcbe29ba19f91a8e6c43f46fb21303d84bc7548cfd8dd53ca99815d84ef7c' \
    'src/main/java/org/limine/entry/tool/processes/LimineWriter.java' \
    'f192f67770f48e4cde85b2d519ab3a5f93421a29810adbeac26043a7ecebe150' \
    'src/main/java/org/limine/entry/tool/processes/Utility.java' |
    sha256sum --check --strict || return 1

  patch -Np1 --fuzz=0 --batch --forward -i "$srcdir/0003-describe-native-outputs.patch" || return 1
  printf '%s  %s\n' \
    'ef5dce3c47f184d86047b10889fe80fa42c556b114367668d323718473897d6e' \
    'src/main/java/org/limine/entry/tool/Main.java' \
    '1ae717cc091060c9811356d6bd21354367386df2c0e6cb991318a7290861fd64' \
    'src/main/java/org/limine/entry/tool/objects/BootOptions.java' \
    'ed1158faf59bdc44409449910aef9e9649e4c520b0cfb190a5f94a87e2e15c96' \
    'src/main/java/org/limine/entry/tool/objects/TreeNode.java' \
    'd7ffb8098e17ebf90d505ed9e0560e30e4f0348bc4881560a0142e60af4e8de5' \
    'src/main/java/org/limine/entry/tool/processes/ConfigReader.java' \
    '4abdccb4402df6e83e72f9039e1a33e3f6fd23ed9f4d89530cb42a6986c263cb' \
    'src/main/java/org/limine/entry/tool/processes/Utility.java' \
    'a14fb4b127deac96d4d82def9f78e1aaa2a08748395d3ed83d67811b14d7a133' \
    'src/main/java/org/limine/entry/tool/processes/MacroReplacer.java' \
    '33bd9a660c3b53546d2fd4b2f712f8c2d269c27d4460d4155dd956cf173646ad' \
    'src/main/java/org/limine/entry/tool/processes/LimineReader.java' \
    '4add0b7c8f99478a63aa3e5b3c65c9c43c70f266fba990eeea232a92619426a2' \
    'src/main/java/org/limine/entry/tool/processes/LimineManager.java' \
    '06255840e98ff9af8747652cbc575f558fb219a71f83da9d3adc511d65a94e80' \
    'src/main/java/org/limine/entry/tool/processes/JsonOutput.java' \
    '9a7cbaa35f7c2ae8ec236a7de8e559e20cc648578ef0076d90588ae3632db8d1' \
    'src/main/java/org/limine/entry/tool/processes/ReadObservation.java' \
    '6485701852be4bd87561f401d8906543e5f1a7978914de5b16e5fe984478682b' \
    'src/main/java/org/limine/entry/tool/processes/OutputLayout.java' \
    '583a2c30bfd0b21655484c2eb60e0da0346cb0452398ba47eff7289f383d0943' \
    'src/main/java/org/limine/entry/tool/processes/NativeDescription.java' \
    '7402fb5df3ea6422a79b7b9b7550c8c842b161fd1fa0f4b378f7b624973cf6e2' \
