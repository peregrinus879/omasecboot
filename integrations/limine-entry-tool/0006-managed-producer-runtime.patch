+package org.limine.entry.tool.processes;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Executor phase: Core authority plus inherited custody across a Core failure. */
+public final class CorePublicationAuthority implements PreparedPublication.Authority {
+    private final ManagedChannel channel;
+    private final Map<Integer, FileState> pins = new LinkedHashMap<>();
+    private final PreparedPublication plan;
+    private boolean invalid;
+    private final LiveMountCustody custody;
+
+    @SuppressWarnings("unchecked")
+    public CorePublicationAuthority(ManagedChannel channel) throws IOException {
+        this.channel = channel;
+        Map<String, Object> application = channel.exchange(Map.of("operation", "application"));
+        if (!application.keySet().equals(Set.of("plan", "pins", "mount_namespace", "directories"))
+                || !(application.get("pins") instanceof List<?> list)
+                || !(application.get("mount_namespace") instanceof String namespace)) {
+            throw new IOException("Incomplete Core application authority");
+        }
+        plan = PreparedPublicationCodec.decode(JsonOutput.encode(application.get("plan")).getBytes(StandardCharsets.UTF_8));
+        for (Object value : list) {
+            if (!(value instanceof Map<?, ?> pin) || !pin.keySet().equals(Set.of("fd", "state")) || !(pin.get("fd") instanceof Long fd)
+                    || fd < 3 || fd > Integer.MAX_VALUE || !(pin.get("state") instanceof Map<?, ?>)) {
+                throw new IOException("Invalid inherited publication pin");
+            }
+            FileState state;
+            try {
+                state = PreparedPublicationCodec.readState((Map<String, Object>) pin.get("state"));
+            } catch (IllegalArgumentException | NullPointerException e) { throw new IOException("Invalid inherited publication state", e); }
+            if (!(state.kind().equals("file") || state.kind().equals("directory")) || pins.putIfAbsent(fd.intValue(), state) != null) {
+                throw new IOException("Invalid or duplicate inherited publication pin");
+            }
+        }
+        if (!plan.deletes().isEmpty() || !plan.references().isEmpty()) throw new IOException("Unsupported managed effect kind");
+        custody = new LiveMountCustody(namespace, application.get("directories"), pins, plan);
+        verifyLive();
+        List<PreparedPublication.Put> puts = new ArrayList<>(plan.puts()); puts.add(plan.configuration());
+        for (PreparedPublication.Put put : puts) {
+            requirePin(put.before()); requirePin(put.after()); requirePin(FileState.capture(put.retained()));
+            for (DirectoryBinding.Component component : put.parent().components()) {
+                if (!component.entry().kind().equals("directory")) throw new IOException("Unsupported link custody in managed attempt");
+                requirePin(component.entry()); requirePin(component.directory());
+            }
+        }
+        verifyLive();
+    }
+
+    private void requirePin(FileState state) throws IOException {
+        if (!state.kind().equals("absent") && pins.values().stream().noneMatch(pin -> pin.same(state))) {
+            throw new IOException("Missing inherited custody for publication identity");
+        }
+    }
+    @Override public void verifyLive() throws IOException {
+        if (invalid) throw new IOException("Publication live custody was invalidated");
+        try { custody.verify(); }
+        catch (IOException error) { invalid = true; throw error; }
+    }
+    private Map<String, Object> exchange(Map<String, Object> message) throws IOException {
+        verifyLive();
+        Map<String, Object> result = channel.exchange(message);
+        verifyLive();
+        return result;
+    }
+    public void apply() throws IOException {
+        plan.apply(this);
+        exchange(Map.of("operation", "complete"));
+    }
+    @Override public void validate(PreparedPublication candidate) throws IOException {
+        exchange(Map.of("operation", "validate-plan", "plan", ManagedJson.read(PreparedPublicationCodec.encode(candidate))));
+    }
+    @Override @SuppressWarnings("unchecked") public PreparedPublication.Frontier frontier(String effect) throws IOException {
+        Map<String, Object> result = exchange(Map.of("operation", "frontier", "id", effect));
+        if (!result.keySet().equals(Set.of("phase", "observed"))) throw new IOException("Invalid effect frontier response");
+        return new PreparedPublication.Frontier((String) result.get("phase"), result.get("observed") == null ? null
+                : PreparedPublicationCodec.readState((Map<String, Object>) result.get("observed")));
+    }
+    @Override public void before(String effect, FileState observed) throws IOException {
+        exchange(Map.of("operation", "before", "id", effect, "state", PreparedPublicationCodec.state(observed)));
+    }
+    @Override @SuppressWarnings("unchecked") public PreparedPublication.Stage stage(PreparedPublication.Put put) throws IOException {
+        Map<String, Object> result = exchange(Map.of("operation", "stage", "id", put.id()));
+        if (!result.keySet().equals(Set.of("path", "state")) || !(result.get("path") instanceof String path)
+                || !(result.get("state") instanceof Map<?, ?>)) throw new IOException("Invalid stage response");
+        try {
+            PreparedPublication.Stage stage = new PreparedPublication.Stage(Path.of(path),
+                    PreparedPublicationCodec.readState((Map<String, Object>) result.get("state")));
+            requirePin(stage.state());
+            custody.registerStage(put, stage);
+            verifyLive();
+            return stage;
+        } catch (IllegalArgumentException | NullPointerException e) { throw new IOException("Invalid stage response", e); }
+    }
+    @Override public void applied(String effect, FileState state) throws IOException {
+        exchange(Map.of("operation", "applied", "id", effect, "state", PreparedPublicationCodec.state(state)));
+    }
+}
