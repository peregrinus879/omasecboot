+    /** One persistent decoder owns the stream, so buffering cannot discard later frames. */
+    public static void forwardFrames(InputStream source, OutputStream destination) throws IOException {
+        InputStream input = new BufferedInputStream(source);
+        OutputStream output = new BufferedOutputStream(destination);
+        ByteArrayOutputStream frame = new ByteArrayOutputStream();
+        int next;
+        while ((next = input.read()) != -1) {
+            if (next == '\n') {
+                byte[] canonical = JsonOutput.encode(read(frame.toByteArray())).getBytes(StandardCharsets.UTF_8);
+                if (canonical.length > MAX_BYTES) throw new IOException("Canonical managed frame exceeds its byte limit");
+                output.write(canonical);
+                output.write('\n');
+                output.flush();
+                frame.reset();
+            } else {
+                if (frame.size() == MAX_BYTES) throw new IOException("Managed frame exceeds its byte limit");
+                frame.write(next);
+            }
+        }
+        if (frame.size() != 0) throw new IOException("Managed stream ended inside a frame");
+    }
 
