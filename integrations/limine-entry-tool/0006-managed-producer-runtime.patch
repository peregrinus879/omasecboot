+package org.limine.entry.tool.processes;
+
+import org.limine.entry.tool.objects.Config;
+import org.limine.entry.tool.objects.EntryOptions;
+import org.limine.entry.tool.objects.TreeNode;
+import org.limine.entry.tool.formats.limine8.Limine;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Captured addition selection/rendering. Preparation makes no canonical writes. */
+public final class ManagedAddition {
+    private final Config config;
+    private final BootResources.Addition addition;
+    private final String comment;
+    private final EntryOptions options;
+    private final String spaces;
+    private final List<String> order;
+    private final boolean sort, hashes, generate;
+    private final LimineReader reader;
+    private final Map<String, Object> intent;
+
+    public ManagedAddition(Config config, BootResources.Addition addition, String comment, EntryOptions options) throws IOException {
+        this.config = config; this.addition = addition; this.comment = comment;
+        this.options = new EntryOptions().setPriority(options.getPriority()).setEntryOverwrite(options.getEntryOverwrite())
+                .setMachineID(options.getMachineID()).setKernelID(options.getKernelID());
+        spaces = Config.SPACES; order = List.copyOf(Arrays.asList(Config.BOOT_ORDER.clone()));
+        sort = Config.ENABLE_SORT; hashes = Config.ENABLE_VERIFICATION || addition.protocol().equals("linux");
+        generate = Config.ENABLE_OS_GENERATION;
+        reader = new LimineReader(config, new ReadObservation());
+        if (!"present".equals(reader.getConfigurationObservation().get("status"))) throw new IOException("Managed configuration must exist");
+        if (reader.getRootNode().findOsCandidates(config.machineID(), config.targetOs(), 1).size() > 1) throw new IOException("Ambiguous managed OS selection");
+        TreeNode os = reader.getTargetOsNode();
+        if (os != null && os.findKernelCandidates(addition.kernelID()).size() > 1) throw new IOException("Ambiguous managed kernel selection");
+        List<Map<String, Object>> resources = new ArrayList<>();
+        int index = 0;
+        for (BootResources.Resource resource : addition.resources()) {
+            if (!resource.copied()) throw new IOException("Referenced-resource managed publication is not yet supported");
+            Path source = Path.of(resource.source()).toAbsolutePath().normalize();
+            resources.add(Map.of("id", "resource-" + index++, "role", resource.role(), "source", source.toString(),
+                    "target", Path.of(resource.destination()).toAbsolutePath().normalize().toString(), "sha256", FileState.hash(source.toRealPath())));
+        }
+        Map<String, Object> model = new LinkedHashMap<>();
+        model.put("machine_id", config.machineID()); model.put("target_os", config.targetOs()); model.put("path_function", config.pathFunction());
+        model.put("kernel_id", addition.kernelID()); model.put("protocol", addition.protocol()); model.put("cmdline", addition.cmdline());
+        model.put("comment", comment); model.put("priority", options.getPriority()); model.put("overwrite", options.getEntryOverwrite());
+        model.put("machine_option", options.getMachineID()); model.put("kernel_option", options.getKernelID());
+        model.put("spaces", spaces); model.put("order", order); model.put("sort", sort); model.put("hashes", hashes); model.put("generate_os", generate);
+        intent = Map.of("operation", addition.protocol().equals("efi") ? "add-uki" : "add-kernel", "esp_path", config.espPath(),
+                "configuration", Map.of("path", config.espPath() + "/limine.conf", "sha256", reader.getConfigurationObservation().get("sha256")),
+                "resources", List.copyOf(resources), "publication", Map.of("kind", "addition", "model", JsonOutput.encode(PreparedPublicationCodec.canonical(model))));
+    }
+
+    public Map<String, Object> intent() { return intent; }
+
+    public void prepare(ManagedChannel channel, String invocation) throws IOException {
+        channel.exchange(Map.of("operation", "match-intent", "intent", intent));
+        List<PreparedPublication.Put> puts = new ArrayList<>();
+        Map<String, String> contents = new LinkedHashMap<>();
+        int index = 0;
+        for (BootResources.Resource resource : addition.resources()) {
+            String id = "resource-" + index++;
+            channel.exchange(Map.of("operation", "retain", "id", id));
+            Map<String, Object> stage = channel.exchange(Map.of("operation", "stage-input", "id", id));
+            puts.add(put(stage));
+            contents.put(resource.destination(), (String) stage.get("retained"));
+        }
+        if (!spaces.equals(Config.SPACES) || !order.equals(Arrays.asList(Config.BOOT_ORDER)) || sort != Config.ENABLE_SORT
+                || hashes != (Config.ENABLE_VERIFICATION || addition.protocol().equals("linux")) || generate != Config.ENABLE_OS_GENERATION) {
+            throw new IOException("Native rendering policy changed during preparation");
+        }
+        TreeNode os = LimineReader.resolveOrCreateOsNode(config, reader.getRootNode(), generate);
+        if (os == null) throw new IOException("Managed OS generation is disabled");
+        List<String> lines = BootResources.render(config, addition,
+                List.of(comment, new EntryOptions().setKernelID(addition.kernelID()).buildKernelComment()), spaces,
+                resource -> contents.get(resource.destination()), (resource, path) -> hashes ? Limine.HASH + Utility.computeBlake2(path) : "");
+        new LimineManager(os, config).updateAddition(addition.kernelID(), lines, options);
+        String text = String.join("\n", new LimineWriter(config).render(reader.getRootNode())) + "\n";
+        Map<String, Object> configStage = channel.exchange(Map.of("operation", "stage-config", "content", text));
+        PreparedPublication plan = new PreparedPublication(invocation, puts, put(configStage), List.of(), List.of());
+        Map<String, Object> document = ManagedJson.read(PreparedPublicationCodec.encode(plan));
+        channel.exchange(Map.of("operation", "prepare-plan", "plan", document));
+        channel.exchange(Map.of("operation", "complete"));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static PreparedPublication.Put put(Map<String, Object> stage) throws IOException {
+        Path target = Path.of((String) stage.get("target"));
+        return new PreparedPublication.Put((String) stage.get("id"), target,
+                PreparedPublicationCodec.readState((Map<String, Object>) stage.get("before")), Path.of((String) stage.get("retained")),
+                PreparedPublicationCodec.readState((Map<String, Object>) ((Map<String, Object>) stage.get("stage")).get("state")),
+                DirectoryBinding.capture(target.getParent()));
+    }
+}
