+package org.limine.entry.tool.processes;
+
+import org.limine.entry.tool.formats.limine8.Limine;
+import org.limine.entry.tool.formats.limine8.LimineEntry;
+import org.limine.entry.tool.objects.Config;
+import org.limine.entry.tool.objects.EntryOptions;
+import org.limine.entry.tool.objects.TreeNode;
+
+import java.io.IOException;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Objects;
+import java.util.regex.Pattern;
+
+/**
+ * Producer-owned selection and in-memory tree mutation. These methods neither
+ * observe paths/mounts nor execute deletions. Requests describe stock intent;
+ * they are not checked filesystem effects or publication authority.
+ */
+public final class NativeMutations {
+    private NativeMutations() {}
+
+    /** Requested utility operation, not an observed filesystem object type. */
+    public enum DeletionKind { FILE, DIRECTORY }
+
+    public record DeletionRequest(DeletionKind kind, String path) {
+        public DeletionRequest {
+            Objects.requireNonNull(kind);
+            Objects.requireNonNull(path);
+        }
+    }
+
+    /** The stock tree-update decision is independent of file-only removal. */
+    public record Result(boolean treeChanged, List<DeletionRequest> deletions) {
+        public Result { deletions = List.copyOf(deletions); }
+    }
+
+    /**
+     * Captured by the observing wrapper. pathFunction is the add URI function
+     * (boot(): or uuid(...):); removal may instead supply only gptUuid, or both.
+     * espFilePath is relative to that resolved mount, retaining stock spelling.
+     * existingFilePath is the case-resolved host path, null for a missing file.
+     * Construction itself is not an observation or proof of the filesystem.
+     */
+    public record ResolvedEfiLocation(String pathFunction, String gptUuid,
+                                      String espFilePath, String existingFilePath) {
+        public ResolvedEfiLocation { Objects.requireNonNull(espFilePath); }
+    }
+
+    public static Result addEfi(TreeNode rootNode, String efiName, String comment,
+                                EntryOptions entryOptions, ResolvedEfiLocation location) throws IOException {
+        Objects.requireNonNull(location);
+        // Even a no-overwrite no-op requires a successfully resolved add input.
+        if (location.existingFilePath() == null || location.pathFunction() == null) {
+            throw new IOException("EFI input location could not be resolved");
+        }
+        TreeNode efiNode = rootNode.findNodeByCleanName(efiName, null, 1);
+        if (efiNode == null) {
+            efiNode = new TreeNode(Limine.ENTRY_KEY + efiName, 1, rootNode.getName(), rootNode.getMacros());
+            efiNode.setEnableLineBreak(true);
+            int position = rootNode.findPositionByLowerPriority(entryOptions.getPriority());
+            rootNode.addNode(position, efiNode);
+        } else if (entryOptions.getEntryOverwrite()) {
+            efiNode.getConfigLines().clear();
+        } else {
+            return new Result(false, List.of());
+        }
+        efiNode.getConfigLines().addAll(List.of(
+                "### This EFI entry is auto-generated by limine-entry-tool",
+                Limine.COMMENT + " " + comment,
+                Limine.COMMENT + " " + entryOptions.buildEntryComment(),
+                Limine.PROTOCOL + " " + Limine.PROTOCOL_EFI,
+                Limine.PATH + " " + location.pathFunction() + location.espFilePath(),
+                ""
+        ));
+        return new Result(true, List.of());
+    }
+
+    public static Result removeEfi(TreeNode rootNode, ResolvedEfiLocation location, boolean keepFiles) {
+        Objects.requireNonNull(location);
+        if (location.pathFunction() == null && location.gptUuid() == null) {
+            return new Result(false, List.of());
+        }
+        boolean changed = false;
+        Iterator<TreeNode> it = rootNode.getNodes().iterator();
+        while (it.hasNext()) {
+            LimineEntry entry = new LimineEntry(it.next());
+            if (entry.containsEfiPath(location.pathFunction(), location.espFilePath())
+                    || entry.containsEfiPath(location.gptUuid(), location.espFilePath())) {
+                it.remove();
+                changed = true;
+            }
+        }
+        List<DeletionRequest> deletions = !keepFiles && location.existingFilePath() != null
+                ? List.of(new DeletionRequest(DeletionKind.FILE, location.existingFilePath())) : List.of();
+        return new Result(changed, deletions);
+    }
+
+    public static Result removeKernel(TreeNode targetOsNode, Config config, String ukiPrefix,
+                                      String kernelName, boolean isUKI) {
+        if (kernelName == null || kernelName.isBlank()) {
+            return new Result(false, List.of());
+        }
+        // The same layout owner supplies the mount-relative selector and host
+        // destination. Selection deliberately uses boot():, not config's URI.
+        Config relative = new Config(config.machineID(), config.targetOs(), "", config.pathFunction());
+        String kernelFilePath;
+        DeletionRequest deletion;
+        if (isUKI) {
+            String fileName = OutputLayout.ukiFileName(config, ukiPrefix, kernelName);
+            kernelFilePath = OutputLayout.ukiDirectory(relative) + fileName;
+            deletion = new DeletionRequest(DeletionKind.FILE, OutputLayout.ukiDirectory(config) + fileName);
+        } else {
+            kernelFilePath = OutputLayout.kernelDirectory(relative, kernelName);
+            String directory = OutputLayout.kernelDirectory(config, kernelName);
+            deletion = new DeletionRequest(DeletionKind.DIRECTORY, directory.substring(0, directory.length() - 1));
+        }
+
+        boolean changed = false;
+        Iterator<TreeNode> it = targetOsNode.getNodes().iterator();
+        while (it.hasNext()) {
+            LimineEntry entry = new LimineEntry(it.next());
+            if (isUKI ? entry.containsEfiPath(Limine.DEFAULT_PATH_FUNCTION.toString(), kernelFilePath)
+                    : entry.containsKernelDirPath(Limine.DEFAULT_PATH_FUNCTION.toString(), kernelFilePath)) {
+                it.remove();
+                changed = true;
+            }
+        }
+        return new Result(changed, List.of(deletion));
+    }
+
+    public static Result removeKernelEntry(TreeNode targetOsNode, String kernelName) {
+        if (kernelName == null || kernelName.isBlank()) {
+            return new Result(false, List.of());
+        }
+        return new Result(targetOsNode.getNodes().removeIf(node -> node.matchesKernelID(kernelName)), List.of());
+    }
+
+    /**
+     * A machine ID selects the first match at the supplied depth. A slash path
+     * selects its Nth occurrence, or all occurrences when matchIndex <= 0.
+     * Selected nodes are cleared in place, preserving stock serialization.
+     */
+    public static Result removeEntry(TreeNode rootNode, String entryPath, int matchIndex) {
+        boolean changed;
+        if (Pattern.compile("([a-f0-9]{32})", Pattern.CASE_INSENSITIVE).matcher(entryPath).matches()) {
+            TreeNode osNode = rootNode.findNodeByMachineID(entryPath, matchIndex);
+            changed = osNode != null;
+            if (changed) osNode.clear();
+        } else {
+            changed = removeRecursive(rootNode, entryPath.split("/", -1), 0, new RemoveState(matchIndex));
+        }
+        return new Result(changed, List.of());
+    }
+
+    private static boolean removeRecursive(TreeNode node, String[] parts, int index, RemoveState state) {
+        if (index >= parts.length) return false;
+        String targetName = parts[index];
+        boolean removed = false;
+        for (TreeNode childNode : node.getNodes()) {
+            boolean matches = targetName.equals(childNode.cleanName) || (targetName.isBlank() && childNode.cleanName.isBlank());
+            if (matches) {
+                if (index == parts.length - 1) {
+                    if (state.removeAll) {
+                        childNode.clear();
+                        removed = true;
+                        continue;
+                    }
+                    state.remaining--;
+                    if (state.remaining == 0) {
+                        childNode.clear();
+                        return true;
+                    }
+                } else if (removeRecursive(childNode, parts, index + 1, state)) {
+                    removed = true;
+                    if (!state.removeAll) return true;
+                }
+            }
+        }
+        return removed;
+    }
+
+    private static class RemoveState {
+        int remaining;
+        final boolean removeAll;
+
+        RemoveState(int matchIndex) {
+            removeAll = matchIndex <= 0;
+            remaining = removeAll ? 0 : matchIndex;
+        }
+    }
+}
