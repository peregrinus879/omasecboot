+package org.limine.entry.tool.processes;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Live held-mount custody for one executor lifetime, never a recovery identity. */
+final class LiveMountCustody {
+    private record Directory(Path path, int fd, String mountId, FileState state) {}
+    private record Observation(Path path, FileState state, String mountId) {}
+    private final String namespace;
+    private final Map<Integer, FileState> pins;
+    private final Map<Integer, String> pinMounts = new LinkedHashMap<>();
+    private final Map<Path, Directory> directories = new LinkedHashMap<>();
+    private final Map<Path, PreparedPublication.Put> targets = new LinkedHashMap<>();
+    private final Map<Path, FileState> stages = new LinkedHashMap<>();
+    private static final Pattern MOUNT_FIELD = Pattern.compile("mnt_id:[\\t ]+([1-9][0-9]*)");
+    private static final Pattern OBJECT = Pattern.compile("([1-9][0-9]*)\\t([0-9]+:[0-9]+)\\t([0-9a-f]{1,4})\\t([0-9]+)\\t([0-9]+)");
+    private static final int BATCH_SIZE = 32;
+
+    // FD 3 is opened here from the current pathname. It is not inherited from
+    // Java. Every external command is fixed and absolute; the environment is empty
+    // except LC_ALL. The observer reads metadata only and never reads file bytes.
+    private static final String OBSERVER = """
+            set -euo pipefail
+            namespace() {
+                local value
+                value=$(/usr/bin/stat --dereference --format='%i' -- /proc/self/ns/mnt)
+                [[ $value =~ ^[1-9][0-9]*$ ]] || exit 91
+                printf 'mnt:[%s]\\n' "$value"
+            }
+            namespace
+            while (( $# )); do
+                (( $# >= 2 )) || exit 91
+                kind=$1 path=$2
+                shift 2
+                [[ ! -L $path ]] || exit 91
+                if [[ $kind == absent ]]; then
+                    [[ ! -e $path ]] || exit 91
+                    printf 'absent\\n'
+                    continue
+                fi
+                case $kind in
+                    directory) [[ -d $path ]] || exit 91 ;;
+                    file) [[ -f $path ]] || exit 91 ;;
+                    *) exit 91 ;;
+                esac
+                exec 3<"$path"
+                case $kind in
+                    directory) [[ -d /proc/self/fd/3 ]] || exit 91 ;;
+                    file) [[ -f /proc/self/fd/3 ]] || exit 91 ;;
+                esac
+                [[ ! -L $path && $path -ef /proc/self/fd/3 ]] || exit 91
+                mount='' bytes=0
+                while IFS= read -r -n 257 line || [[ -n $line ]]; do
+                    (( ${#line} <= 256 )) || exit 91
+                    (( bytes += ${#line} + 1 ))
+                    (( bytes <= 4096 )) || exit 91
+                    if [[ $line == mnt_id:* ]]; then
+                        [[ -z $mount && $line =~ ^mnt_id:[[:blank:]]+([1-9][0-9]*)$ ]] || exit 91
+                        mount=${BASH_REMATCH[1]}
+                    fi
+                done < /proc/self/fdinfo/3
+                [[ -n $mount ]] || exit 91
+                printf '%s\\t' "$mount"
+                /usr/bin/stat --dereference --printf='%d:%i\\t%f\\t%u\\t%g\\n' -- /proc/self/fd/3
+                [[ ! -L $path && $path -ef /proc/self/fd/3 ]] || exit 91
+                exec 3<&-
+            done
+            namespace
+            """;
+
+    LiveMountCustody(String namespace, Object suppliedDirectories, Map<Integer, FileState> pins,
+                     PreparedPublication plan) throws IOException {
+        if (!namespace.matches("mnt:\\[[1-9][0-9]*]")) throw new IOException("Invalid publication mount namespace");
+        this.namespace = namespace;
+        this.pins = Map.copyOf(pins);
+        Map<Path, FileState> required = new LinkedHashMap<>();
+        List<PreparedPublication.Put> puts = new ArrayList<>(plan.puts()); puts.add(plan.configuration());
+        for (PreparedPublication.Put put : puts) {
+            targets.put(put.target(), put);
+            for (DirectoryBinding.Component component : put.parent().components()) {
+                if (!component.entry().kind().equals("directory") || !component.entry().same(component.directory())) {
+                    throw new IOException("Unsupported link custody in managed attempt");
+                }
+                FileState prior = required.putIfAbsent(component.path(), component.directory());
+                if (prior != null && !prior.same(component.directory())) throw new IOException("Inconsistent directory custody coverage");
