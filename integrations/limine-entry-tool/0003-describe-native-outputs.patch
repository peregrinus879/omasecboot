+package org.limine.entry.tool.processes;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.NoSuchFileException;
+import java.nio.file.Path;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Non-initializing reads and evidence for bytes actually parsed by a query. */
+public final class ReadObservation {
+    private final List<Map<String, Object>> inputs = new ArrayList<>();
+
+    public List<Map<String, Object>> inputs() {
+        return List.copyOf(inputs);
+    }
+
+    public Map<String, Object> lastRead(Path path) {
+        for (int i = inputs.size() - 1; i >= 0; i--) {
+            Map<String, Object> input = inputs.get(i);
+            if (path.toString().equals(input.get("path"))) return Map.copyOf(input);
+        }
+        throw new IllegalArgumentException("No captured input: " + path);
+    }
+
+    public Map<String, Object> path(Path requested) throws IOException {
+        Path absolute = requested.toAbsolutePath();
+        Path current = absolute.getRoot();
+        List<Map<String, Object>> links = new ArrayList<>();
+        for (Path part : absolute) {
+            current = current.resolve(part);
+            BasicFileAttributes attributes;
+            try {
+                attributes = Files.readAttributes(current, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+            } catch (NoSuchFileException e) {
+                Map<String, Object> result = new LinkedHashMap<>();
+                result.put("path", requested.toString());
+                result.put("status", "absent");
+                result.put("missing_at", current.toString());
+                result.put("links", links);
+                return result;
+            }
+            if (attributes.isSymbolicLink()) {
+                Map<String, Object> link = new LinkedHashMap<>();
+                link.put("path", current.toString());
+                link.put("target", Files.readSymbolicLink(current).toString());
+                link.put("identity", identity(current, LinkOption.NOFOLLOW_LINKS));
+                links.add(link);
+                // A dangling or looping ancestor is not optional-file absence.
+                Files.readAttributes(current, BasicFileAttributes.class);
+            }
+        }
+        BasicFileAttributes attributes = Files.readAttributes(absolute, BasicFileAttributes.class);
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("path", requested.toString());
+        result.put("status", "present");
+        result.put("type", attributes.isRegularFile() ? "file" : attributes.isDirectory() ? "directory" : "other");
+        result.put("resolved_path", absolute.toRealPath().toString());
+        result.put("identity", identity(absolute));
+        result.put("links", links);
+        return result;
+    }
+
+    private static Map<String, String> identity(Path path, LinkOption... options) throws IOException {
+        Map<String, Object> attributes = Files.readAttributes(path, "unix:dev,ino,uid,gid,mode,size,lastModifiedTime", options);
+        Map<String, String> result = new LinkedHashMap<>();
+        for (String key : List.of("dev", "ino", "uid", "gid", "mode", "size", "lastModifiedTime")) {
+            result.put(key, attributes.get(key).toString());
+        }
+        return result;
+    }
+
+    public String optionalText(Path path) throws IOException {
+        Map<String, Object> before = path(path);
+        if (before.get("status").equals("absent")) {
+            inputs.add(before);
+            return null;
+        }
+        if (!before.get("type").equals("file") && !before.get("resolved_path").equals("/dev/null")) {
+            throw new IOException("Expected a regular input file: " + path);
+        }
+        byte[] bytes = Files.readAllBytes(path);
+        Map<String, Object> after = path(path);
+        if (!before.equals(after)) {
+            throw new IOException("Input changed while reading: " + path);
+        }
+        try {
+            before.put("sha256", HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)));
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+        inputs.add(before);
+        return StandardCharsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(bytes)).toString();
+    }
+
+    public List<Path> configDirectory(Path directory) throws IOException {
+        Map<String, Object> before = path(directory);
+        if (!before.get("status").equals("present") || !before.get("type").equals("directory")) {
+            inputs.add(before);
+            return List.of();
+        }
+        List<Path> candidates;
+        try (var stream = Files.list(directory)) {
+            candidates = stream.filter(p -> p.getFileName().toString().endsWith(".conf"))
+                    .sorted(Comparator.comparing(Path::getFileName)).toList();
+        }
+        List<Path> files = new ArrayList<>();
+        List<Map<String, Object>> entries = new ArrayList<>();
+        for (Path candidate : candidates) {
+            Map<String, Object> observation = path(candidate);
+            entries.add(observation);
+            if (observation.get("status").equals("present") && observation.get("type").equals("file")) {
+                files.add(candidate);
+            }
+        }
+        if (!before.equals(path(directory))) {
+            throw new IOException("Configuration directory changed while listing: " + directory);
+        }
+        before.put("entries", entries);
+        inputs.add(before);
+        return files;
+    }
+}
