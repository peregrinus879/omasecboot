+package org.limine.entry.tool.processes;
+
+import org.limine.entry.tool.formats.limine8.Limine;
+import org.limine.entry.tool.objects.BootOptions;
+import org.limine.entry.tool.objects.Config;
+import org.limine.entry.tool.objects.TreeNode;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Native-operation facts, not package inventory, publication or boot proof. */
+public final class NativeDescription {
+    private NativeDescription() {}
+
+    private static final Set<String> CONTROL_OPERANDS = Set.of("--quiet", "--help", "--version", "--comment",
+            "--keep-files", "--priority", "--overwrite", "--no-mutex", "--mutex", "--no-hooks", "--hooks", "--get-cmdline");
+
+    private record Request(String kind, String name, String suffix, List<String> sources) {
+        String kernelID() { return name + suffix; }
+    }
+
+    private static Map<String, Object> object(Object... pairs) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        for (int i = 0; i < pairs.length; i += 2) {
+            result.put((String) pairs[i], pairs[i + 1]);
+        }
+        return result;
+    }
+
+    private static Request request(String[] args) {
+        for (int i = 1; i < args.length; i++) {
+            if (CONTROL_OPERANDS.contains(args[i])) {
+                throw new IllegalArgumentException("Mutation control is not a description operand: " + args[i]);
+            }
+        }
+        if (args.length == 1 && args[0].equals("context")) {
+            return new Request("context", "", "", List.of());
+        }
+        if (args.length < 3) throw new IllegalArgumentException("Missing description operands");
+        String kind = args[0];
+        String name = args[1];
+        String suffix = "";
+        List<String> sources;
+        if (kind.equals("add-uki") && args.length == 3) {
+            sources = List.of(args[2]);
+        } else if (kind.equals("add-kernel") && (args.length == 4 || args.length == 5)) {
+            suffix = args.length == 5 ? args[4] : "";
+            sources = List.of(args[2], args[3]);
+        } else {
+            throw new IllegalArgumentException("Unsupported description operation or operand count");
+        }
+        if (!Utility.isValidFat32Name(name + suffix)) {
+            throw new IllegalArgumentException("Invalid native kernel name");
+        }
+        for (String source : sources) {
+            if (source.isBlank() || OutputLayout.inputBasename(source).isEmpty()) {
+                throw new IllegalArgumentException("Invalid prospective source operand");
+            }
+        }
+        return new Request(kind, name.trim(), suffix.trim(), sources);
+    }
+
+    public static int run(String[] args) {
+        Map<String, Object> result = object("format", "limine-native-description", "schema", 1,
+                "scope", "native-operation", "complete", false);
+        List<Map<String, Object>> errors = new ArrayList<>();
+        result.put("errors", errors);
+        Request request;
+        try {
+            request = request(args);
+        } catch (IllegalArgumentException e) {
+            errors.add(object("kind", "invalid-request", "message", e.getMessage()));
+            System.out.println(JsonOutput.encode(result));
+            return 2;
+        }
+
+        result.put("operation", object("kind", request.kind, "name", request.name,
+                "suffix", request.suffix, "sources", request.sources));
+        ReadObservation inputs = new ReadObservation();
+        try {
+            ConfigReader reader = new ConfigReader(inputs);
+            String machineID = Utility.readExistingMachineID(inputs);
+            String targetOs = reader.targetOs();
+            if (targetOs == null || targetOs.isEmpty()) {
+                throw new IOException("Native target OS could not be resolved");
+            }
+            List<Map<String, Object>> espCandidates = new ArrayList<>();
+            String esp = reader.configuredEspPath();
+            boolean explicitEsp = esp != null && !esp.isBlank();
+            if (!explicitEsp) {
+                esp = null;
+                for (String candidate : List.of("/efi", "/boot", "/boot/efi", "/limine")) {
+                    Map<String, Object> facts = filesystem(candidate, inputs);
+                    espCandidates.add(facts);
+                    if (Boolean.TRUE.equals(facts.get("vfat"))) {
+                        esp = candidate;
+                        break;
+                    }
+                }
+                if (esp == null) throw new IOException("No native ESP candidate resolved to FAT32");
+            }
+            Map<String, Object> filesystem = filesystem(esp, inputs);
+            String prefix = reader.ukiPrefix(machineID);
+            boolean verification = reader.verificationEnabled();
+            Map<String, String> cmdlines = reader.readBootOptions();
+            Config config = new Config(machineID, targetOs, esp, Limine.DEFAULT_PATH_FUNCTION.toString());
+            result.put("context", object("machine_id", machineID, "target_os", targetOs,
+                    "esp_path", esp, "esp_explicit", explicitEsp, "filesystem", filesystem,
+                    "esp_candidates", espCandidates, "config_path", Utility.buildPath(esp, Config.LIMINE_CONFIG_FILE),
+                    "uki_prefix", prefix, "verification_enabled", verification,
+                    "verification_basis", object("path_environment", System.getenv("PATH"),
+                            "hash_command", Config.HASH_COMMAND, "requires_fresh_availability_check", true),
+                    "kernel_cmdlines", new LinkedHashMap<>(cmdlines)));
+            result.put("mutation_preconditions", object("esp_vfat", filesystem.get("vfat")));
+
+            if (!request.kind.equals("context")) {
+                result.put("expected", expected(config, prefix, verification, cmdlines, request, inputs));
+            }
+            LimineReader limine = new LimineReader(config, inputs);
+            List<TreeNode> osCandidates = limine.getRootNode().findOsCandidates(machineID, targetOs, 1);
+            List<Map<String, Object>> nodes = new ArrayList<>();
+            for (TreeNode node : osCandidates) {
+                List<TreeNode> kernels = request.kind.equals("context")
+                        ? List.of() : node.findKernelCandidates(request.kernelID());
+                List<Map<String, Object>> children = new ArrayList<>();
+                for (TreeNode kernel : kernels) {
+                    children.add(object("position", node.getNodes().indexOf(kernel), "name", kernel.getName(),
+                            "clean_name", kernel.getCleanName(), "kernel_id", kernel.getOrCreateOptions().getKernelID(),
+                            "basis", kernel.getOrCreateOptions().getKernelID().isEmpty() ? "display-name" : "kernel-id",
+                            "lines", List.copyOf(kernel.getConfigLines())));
+                }
+                if (kernels.size() > 1) {
+                    errors.add(object("kind", "ambiguous-kernel", "message", "Multiple direct native kernel matches"));
+                }
+                nodes.add(object("position", limine.getRootNode().getNodes().indexOf(node), "name", node.getName(),
+                        "clean_name", node.getCleanName(), "machine_id", node.getOrCreateOptions().getMachineID(),
+                        "lines", List.copyOf(node.getConfigLines()), "kernel_candidates", children));
+            }
+            if (osCandidates.size() > 1) {
+                errors.add(object("kind", "ambiguous-os", "message", "Multiple native current-OS matches"));
+            }
+            String basis = osCandidates.isEmpty() ? "absent"
+                    : machineID.equals(osCandidates.getFirst().getOrCreateOptions().getMachineID()) ? "machine-id" : "compatible-name";
+            result.put("observed", object("interpretation", "native-association-and-raw-lines", "semantics", "as-read", "os_basis", basis,
+                    "configuration", limine.getConfigurationObservation(),
+                    "os_candidates", nodes));
+            result.put("complete", errors.isEmpty());
+        } catch (IOException | RuntimeException e) {
+            errors.add(object("kind", "incomplete-observation", "message", e.getMessage()));
+        }
+        result.put("inputs", inputs.inputs());
+        System.out.println(JsonOutput.encode(result));
+        return errors.isEmpty() ? 0 : 1;
+    }
+
+    private static Map<String, Object> filesystem(String path, ReadObservation inputs) throws IOException {
+        Map<String, Object> observation = inputs.path(Path.of(path));
+        String type = null;
+        if (observation.get("status").equals("present") && observation.get("type").equals("directory")) {
+            type = Files.getFileStore(Path.of(path)).type();
+        }
+        return object("path", observation, "type", type, "vfat", "vfat".equalsIgnoreCase(type));
+    }
+
+    private static Map<String, Object> expected(Config config, String prefix, boolean verification,
+            Map<String, String> cmdlines, Request request, ReadObservation inputs) throws IOException {
+        String cmdline = BootOptions.getKernelCmdline(cmdlines, request.kernelID());
+        List<Map<String, Object>> resources = new ArrayList<>();
+        String protocol;
+        if (request.kind.equals("add-uki")) {
+            protocol = "efi";
+            cmdline = BootOptions.cleanKernelParameters(cmdline, false).cmdline();
+            String target = OutputLayout.ukiDirectory(config) + OutputLayout.ukiFileName(config, prefix, request.name);
+            resources.add(resource("uki", request.sources.getFirst(), target, "copied", config, inputs));
+        } else {
+            protocol = "linux";
+            BootOptions.KernelParams options = BootOptions.cleanKernelParameters(cmdline, true);
+            cmdline = options.cmdline();
+            for (String module : options.initrds()) {
+                String target = Utility.buildPath(config.espPath(), module);
+                resources.add(resource("extra-initrd", target, target, "referenced", config, inputs));
+            }
+            String directory = OutputLayout.kernelDirectory(config, request.name);
+            resources.add(resource("initramfs", request.sources.get(0), directory + OutputLayout.inputBasename(request.sources.get(0)), "copied", config, inputs));
+            resources.add(resource("kernel", request.sources.get(1), directory + OutputLayout.inputBasename(request.sources.get(1)), "copied", config, inputs));
+        }
+        return object("kernel_id", request.kernelID(), "new_entry_default_name", request.kernelID(), "protocol", protocol,
+                "cmdline", cmdline, "native_hash_policy", verification ? "present" : "absent", "resources", resources);
+    }
+
+    private static Map<String, Object> resource(String role, String source, String target, String disposition,
+            Config config, ReadObservation inputs) throws IOException {
+        String esp = Utility.buildPath(config.espPath());
+        return object("role", role, "source", source, "source_observation", inputs.path(Path.of(source)),
+                "destination", target, "destination_observation", inputs.path(Path.of(target)),
+                "prospective_uri", config.pathFunction() + target.substring(esp.length()), "disposition", disposition);
+    }
+}
