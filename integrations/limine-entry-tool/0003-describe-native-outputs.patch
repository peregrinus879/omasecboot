+package org.limine.entry.tool.processes;
+
+import org.limine.entry.tool.objects.Config;
+
+import java.io.File;
+
+/** Pure native destination rules, shared by publication and description. */
+public final class OutputLayout {
+    private OutputLayout() {}
+
+    public static String kernelDirectory(Config config, String kernelName) {
+        return Utility.buildPath(config.espPath(), config.machineID(), kernelName) + File.separator;
+    }
+
+    public static String inputBasename(String input) {
+        return Utility.extractFileNameFromPath(input.trim());
+    }
+
+    public static String ukiFileName(Config config, String prefix, String kernelName) {
+        String ukiFileName = kernelName;
+        if (!kernelName.toLowerCase().endsWith(Config.UKI_FILE_SUFFIX)) {
+            ukiFileName = ukiFileName + Config.UKI_FILE_SUFFIX;
+        }
+        if (prefix != null && !prefix.isBlank()) {
+            if (!kernelName.startsWith(prefix)) {
+                ukiFileName = prefix + "_" + ukiFileName;
+            }
+        } else if (!kernelName.startsWith(config.machineID())) {
+            ukiFileName = config.machineID() + "_" + ukiFileName;
+        }
+        return ukiFileName;
+    }
+
+    public static String ukiDirectory(Config config) {
+        return Utility.buildPath(config.espPath(), Config.DEFAULT_UKI_DIR_PATH) + File.separator;
+    }
+}
