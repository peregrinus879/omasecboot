+package org.limine.entry.tool.processes;
+
+import tools.jackson.core.JacksonException;
+import tools.jackson.core.JsonParser;
+import tools.jackson.core.JsonToken;
+import tools.jackson.core.ObjectReadContext;
+import tools.jackson.core.StreamReadConstraints;
+import tools.jackson.core.StreamReadFeature;
+import tools.jackson.core.json.JsonFactory;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Data-only decoding for bounded, versioned producer/core protocol documents. */
+public final class ManagedJson {
+    public static final int MAX_BYTES = 2 * 1024 * 1024;
+    private static final JsonFactory FACTORY = JsonFactory.builder()
+            .enable(StreamReadFeature.STRICT_DUPLICATE_DETECTION)
+            .streamReadConstraints(StreamReadConstraints.builder()
+                    .maxDocumentLength(MAX_BYTES)
+                    .maxNestingDepth(64)
+                    .maxTokenCount(65536)
+                    .maxNameLength(256)
+                    .maxStringLength(1024 * 1024)
+                    .maxNumberLength(20)
+                    .build())
+            .build();
+
+    private ManagedJson() {}
+
+    public static Map<String, Object> read(InputStream input) throws IOException {
+        return read(input.readNBytes(MAX_BYTES + 1));
+    }
+
+    public static Map<String, Object> read(byte[] input) throws IOException {
+        if (input.length > MAX_BYTES) throw new IOException("Managed JSON document exceeds its byte limit");
+        try {
+            StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT)
+                    .decode(ByteBuffer.wrap(input));
+        } catch (CharacterCodingException e) {
+            throw new IOException("Managed JSON is not UTF-8", e);
+        }
+        try (JsonParser parser = FACTORY.createParser(ObjectReadContext.empty(), input)) {
+            if (parser.nextToken() != JsonToken.START_OBJECT) throw new IOException("Managed JSON must be one object");
+            Map<String, Object> result = readObject(parser);
+            if (parser.nextToken() != null) throw new IOException("Managed JSON has a trailing document");
+            return result;
+        } catch (JacksonException e) {
+            throw new IOException("Invalid managed JSON document", e);
+        }
+    }
+
+    private static Map<String, Object> readObject(JsonParser parser) throws IOException {
+        Map<String, Object> result = new LinkedHashMap<>();
+        while (parser.nextToken() != JsonToken.END_OBJECT) {
+            if (parser.currentToken() != JsonToken.PROPERTY_NAME) throw new IOException("Missing JSON property name");
+            String name = checkedText(parser.currentName());
+            if (parser.nextToken() == null) throw new IOException("Missing JSON property value");
+            result.put(name, readValue(parser));
+        }
+        return Collections.unmodifiableMap(result);
+    }
+
+    private static List<Object> readArray(JsonParser parser) throws IOException {
+        List<Object> result = new ArrayList<>();
+        while (parser.nextToken() != JsonToken.END_ARRAY) {
+            if (parser.currentToken() == null) throw new IOException("Unterminated JSON array");
+            result.add(readValue(parser));
+        }
+        return Collections.unmodifiableList(result);
+    }
+
+    private static Object readValue(JsonParser parser) throws IOException {
+        return switch (parser.currentToken()) {
+            case START_OBJECT -> readObject(parser);
+            case START_ARRAY -> readArray(parser);
+            case VALUE_STRING -> checkedText(parser.getString());
+            case VALUE_NUMBER_INT -> parser.getLongValue();
+            case VALUE_TRUE -> true;
+            case VALUE_FALSE -> false;
+            case VALUE_NULL -> null;
+            default -> throw new IOException("Unsupported managed JSON value");
+        };
+    }
+
+    private static String checkedText(String text) throws IOException {
+        for (int i = 0; i < text.length(); i++) {
+            char current = text.charAt(i);
+            if (Character.isHighSurrogate(current)) {
+                if (++i >= text.length() || !Character.isLowSurrogate(text.charAt(i))) {
+                    throw new IOException("Unpaired Unicode surrogate in managed JSON");
+                }
+            } else if (Character.isLowSurrogate(current)) {
+                throw new IOException("Unpaired Unicode surrogate in managed JSON");
+            }
+        }
+        return text;
+    }
+}
