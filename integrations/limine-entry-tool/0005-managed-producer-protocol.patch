+package org.limine.entry.tool.processes;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedOutputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.Closeable;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.Map;
+import java.util.Set;
+
+/** Per-invocation data channel to the supervising Core, never an authority token. */
+public final class ManagedChannel implements Closeable {
+    private final String invocation;
+    private final InputStream responses;
+    private final OutputStream requests;
+    private long sequence;
+
+    public ManagedChannel(String invocation, InputStream responses, OutputStream requests) throws IOException {
+        requireInvocation(invocation);
+        this.invocation = invocation;
+        this.responses = new BufferedInputStream(responses);
+        this.requests = new BufferedOutputStream(requests);
+    }
+
+    private static void requireInvocation(String invocation) throws IOException {
+        if (invocation == null || !invocation.matches("[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}")) {
+            throw new IOException("Invalid producer invocation identifier");
+        }
+    }
+
+    public static ManagedChannel inherited(String invocation) throws IOException {
+        requireInvocation(invocation);
+        Path request = Path.of("/proc/self/fd/198");
+        Path response = Path.of("/proc/self/fd/199");
+        requirePipe(request);
+        requirePipe(response);
+        if (Files.readSymbolicLink(request).equals(Files.readSymbolicLink(response))) {
+            throw new IOException("Producer channel directions share one pipe");
+        }
+        InputStream input = Files.newInputStream(response);
+        try {
+            return new ManagedChannel(invocation, input, Files.newOutputStream(request, StandardOpenOption.WRITE));
+        } catch (IOException | RuntimeException e) {
+            input.close();
+            throw e;
+        }
+    }
+
+    private static void requirePipe(Path path) throws IOException {
+        int mode = ((Number) Files.getAttribute(path, "unix:mode")).intValue();
+        if ((mode & 0170000) != 0010000 || !Files.readSymbolicLink(path).toString().startsWith("pipe:[")) {
+            throw new IOException("Producer channel descriptor is not an anonymous pipe");
+        }
+    }
+
+    public synchronized Map<String, Object> exchange(Map<String, Object> payload) throws IOException {
+        long current = ++sequence;
+        byte[] request = JsonOutput.encode(Map.of("format", "omasecboot-producer-request", "schema", 1,
+                "invocation", invocation, "sequence", current, "payload", payload)).getBytes(StandardCharsets.UTF_8);
+        if (request.length > ManagedJson.MAX_BYTES) throw new IOException("Producer request exceeds its byte limit");
+        requests.write(request);
+        requests.write('\n');
+        requests.flush();
+        Map<String, Object> response = ManagedJson.read(readFrame());
+        if (!response.keySet().equals(Set.of("format", "schema", "invocation", "sequence", "ok", "payload"))
+                || !"omasecboot-producer-response".equals(response.get("format"))
+                || !Long.valueOf(1).equals(response.get("schema"))
+                || !invocation.equals(response.get("invocation"))
+                || !Long.valueOf(current).equals(response.get("sequence"))
+                || !(response.get("ok") instanceof Boolean)
+                || !(response.get("payload") instanceof Map<?, ?>)) {
+            throw new IOException("Producer response does not match its invocation/request");
+        }
+        if (!Boolean.TRUE.equals(response.get("ok"))) throw new IOException("Core refused the producer request");
+        // ManagedJson only constructs string-keyed maps and data values.
+        @SuppressWarnings("unchecked")
+        Map<String, Object> result = (Map<String, Object>) response.get("payload");
+        return result;
+    }
+
+    private byte[] readFrame() throws IOException {
+        ByteArrayOutputStream frame = new ByteArrayOutputStream();
+        while (frame.size() <= ManagedJson.MAX_BYTES) {
+            int value = responses.read();
+            if (value < 0) throw new IOException("Core closed an incomplete producer response");
+            if (value == '\n') return frame.toByteArray();
+            frame.write(value);
+        }
+        throw new IOException("Producer response exceeds its byte limit");
+    }
+
+    @Override public void close() throws IOException {
+        IOException failure = null;
+        try {
+            requests.close();
+        } catch (IOException e) {
+            failure = e;
+        }
+        try {
+            responses.close();
+        } catch (IOException e) {
+            if (failure == null) failure = e; else failure.addSuppressed(e);
+        }
+        if (failure != null) throw failure;
+    }
+}
