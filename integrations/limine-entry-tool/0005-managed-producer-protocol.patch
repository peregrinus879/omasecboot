+package org.limine.entry.tool.processes;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.ArrayDeque;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Predicate;
+
+/** Parent identity chains survive our own content changes, but not namespace rebinding. */
+public record DirectoryBinding(Path path, List<Component> components, List<Dependency> dependencies) {
+    public record Dependency(Path path, FileState entry, String parentIdentity) {
+        public Dependency {
+            if (path == null || !path.isAbsolute() || !path.equals(path.normalize()) || entry == null
+                    || !(entry.kind().equals("directory") || entry.kind().equals("link") || entry.kind().equals("file"))
+                    || (path.getParent() == null ? parentIdentity != null : parentIdentity == null || !parentIdentity.matches("[0-9]+:[0-9]+"))) {
+                throw new IllegalArgumentException("Invalid directory resolution dependency");
+            }
+        }
+    }
+    public record Component(Path path, FileState entry, FileState directory) {
+        public Component {
+            if (path == null || entry == null || directory == null || !directory.kind().equals("directory")
+                    || !(entry.kind().equals("directory") || entry.kind().equals("link"))) {
+                throw new IllegalArgumentException("Invalid directory binding component");
+            }
+        }
+    }
+
+    public DirectoryBinding {
+        if (path == null || !path.isAbsolute() || !path.equals(path.normalize())) {
+            throw new IllegalArgumentException("Invalid directory binding path");
+        }
+        components = List.copyOf(components);
+        dependencies = List.copyOf(dependencies);
+        if (dependencies.isEmpty() || dependencies.stream().map(Dependency::path).distinct().count() != dependencies.size()) {
+            throw new IllegalArgumentException("Incomplete directory resolution dependencies");
+        }
+        List<Path> chain = chain(path);
+        if (!chain.equals(components.stream().map(Component::path).toList())) {
+            throw new IllegalArgumentException("Incomplete directory binding");
+        }
+    }
+
+    private static List<Path> chain(Path path) {
+        List<Path> result = new ArrayList<>();
+        Path current = path.getRoot();
+        result.add(current);
+        for (Path part : path) { current = current.resolve(part); result.add(current); }
+        return result;
+    }
+
+    public static DirectoryBinding capture(Path path) throws IOException {
+        List<Component> components = new ArrayList<>();
+        Map<Path, Dependency> dependencies = new LinkedHashMap<>();
+        for (Path current : chain(path)) {
+            FileState entry = FileState.capture(current);
+            FileState directory = FileState.capture(current.toRealPath());
+            if (!directory.kind().equals("directory")) throw new IOException("Publication parent is not a directory: " + current);
+            components.add(new Component(current, entry, directory));
+            for (Dependency dependency : resolutionDependencies(current)) {
+                Dependency previous = dependencies.putIfAbsent(dependency.path(), dependency);
+                if (previous != null && !previous.equals(dependency)) throw new IOException("Directory resolution changed while capturing");
+            }
+        }
+        DirectoryBinding binding = new DirectoryBinding(path, components, List.copyOf(dependencies.values()));
+        binding.verify(ignored -> false);
+        return binding;
+    }
+
+    public void verify(Predicate<Path> removedAncestor) throws IOException {
+        Map<Path, Dependency> observed = new LinkedHashMap<>();
+        for (Component component : components) {
+            FileState entry = FileState.capture(component.path());
+            if (entry.kind().equals("absent") && removedAncestor.test(component.path())) return;
+            if (!component.entry().same(entry) || !component.directory().same(FileState.capture(component.path().toRealPath()))) {
+                throw new IOException("Publication directory binding changed: " + component.path());
+            }
+            for (Dependency dependency : resolutionDependencies(component.path())) {
+                if (!dependencies.contains(dependency)) throw new IOException("Directory resolution dependency changed: " + dependency.path());
+                observed.put(dependency.path(), dependency);
+            }
+        }
+        if (!List.copyOf(observed.values()).equals(dependencies)) throw new IOException("Incomplete directory resolution binding");
+    }
+
+    /** Follow every link expansion, including links hidden inside another link target. */
+    public static List<Dependency> resolutionDependencies(Path requested) throws IOException {
+        Map<Path, Dependency> result = new LinkedHashMap<>();
+        ArrayDeque<Path> remaining = new ArrayDeque<>();
+        requested.forEach(remaining::addLast);
+        Path current = requested.getRoot();
+        result.put(current, new Dependency(current, FileState.capture(current), null));
+        int links = 0;
+        while (!remaining.isEmpty()) {
+            Path part = remaining.removeFirst();
+            if (part.toString().equals(".") || part.toString().isEmpty()) continue;
+            if (part.toString().equals("..")) { if (current.getParent() != null) current = current.getParent(); continue; }
+            FileState parent = FileState.capture(current);
+            current = current.resolve(part);
+            FileState entry = FileState.capture(current);
+            if (!(entry.kind().equals("directory") || entry.kind().equals("link") || (entry.kind().equals("file") && remaining.isEmpty()))) {
+                throw new IOException("Unresolved directory dependency: " + current);
+            }
+            Dependency dependency = new Dependency(current, entry, parent.identity());
+            Dependency prior = result.putIfAbsent(current, dependency);
+            if (prior != null && !prior.equals(dependency)) throw new IOException("Directory changed while resolving: " + current);
+            if (entry.kind().equals("link")) {
+                if (++links > 40) throw new IOException("Too many directory symlink expansions");
+                Path target = Path.of(entry.linkTarget());
+                current = target.isAbsolute() ? target.getRoot() : current.getParent();
+                List<Path> parts = new ArrayList<>(); target.forEach(parts::add);
+                for (int i = parts.size() - 1; i >= 0; i--) remaining.addFirst(parts.get(i));
+            }
+        }
+        if (!Files.isSameFile(current, requested)) throw new IOException("Directory resolution disagrees with the filesystem");
+        return List.copyOf(result.values());
+    }
+
+    /** Durability for a removed descendant is established through its surviving ancestor. */
+    public Path survivingDirectory() throws IOException {
+        for (int i = components.size() - 1; i >= 0; i--) {
+            Path current = components.get(i).path();
+            if (Files.exists(current)) return current;
+        }
+        throw new IOException("Publication has no surviving directory");
+    }
+}
