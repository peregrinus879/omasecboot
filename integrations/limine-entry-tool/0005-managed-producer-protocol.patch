+package org.limine.entry.tool.processes;
+
+import org.limine.entry.tool.formats.limine8.Limine;
+import org.limine.entry.tool.objects.BootOptions;
+import org.limine.entry.tool.objects.Config;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Producer-owned addition resources and rendering, shared by query and execution. */
+public final class BootResources {
+    private BootResources() {}
+
+    public record Resource(String role, String source, String destination, boolean copied) {}
+    public record Addition(String kernelID, String protocol, String cmdline, List<Resource> resources) {
+        public Addition { resources = List.copyOf(resources); }
+    }
+
+    @FunctionalInterface
+    public interface ResourcePath {
+        String resolve(Resource resource) throws IOException;
+    }
+
+    @FunctionalInterface
+    public interface ResourceHash {
+        String suffix(Resource resource, String contentPath) throws IOException;
+    }
+
+    public static Addition uki(Config config, String prefix, String name, String source, String cmdline) {
+        String target = OutputLayout.ukiDirectory(config) + OutputLayout.ukiFileName(config, prefix, name);
+        return new Addition(name, "efi", BootOptions.cleanKernelParameters(cmdline, false).cmdline(),
+                List.of(new Resource("uki", source, target, true)));
+    }
+
+    public static Addition kernel(Config config, String name, String suffix, String initramfs, String kernel, String cmdline) {
+        BootOptions.KernelParams options = BootOptions.cleanKernelParameters(cmdline, true);
+        List<Resource> resources = new ArrayList<>();
+        for (String module : options.initrds()) {
+            String target = Utility.buildPath(config.espPath(), module);
+            resources.add(new Resource("extra-initrd", target, target, false));
+        }
+        String directory = OutputLayout.kernelDirectory(config, name);
+        resources.add(new Resource("initramfs", initramfs, directory + OutputLayout.inputBasename(initramfs), true));
+        resources.add(new Resource("kernel", kernel, directory + OutputLayout.inputBasename(kernel), true));
+        return new Addition(name + suffix, "linux", options.cmdline(), resources);
+    }
+
+    public static void requireInputs(Addition addition) throws IOException {
+        for (Resource resource : addition.resources()) {
+            String input = resource.copied() ? resource.source() : Utility.correctCaseSensitivePath(resource.source());
+            if (input == null || !Utility.isFilePresent(input)) {
+                throw new IOException("Required " + resource.role() + " input not found: " + resource.source());
+            }
+        }
+    }
+
+    public static List<String> render(Config config, Addition addition, List<String> comments, String spaces,
+            ResourcePath content, ResourceHash hash) throws IOException {
+        List<String> lines = new ArrayList<>();
+        for (String comment : comments) {
+            if (!comment.isBlank()) lines.add(spaces + Limine.COMMENT + " " + comment);
+        }
+        lines.add(spaces + Limine.PROTOCOL + " " + addition.protocol());
+        String esp = Utility.buildPath(config.espPath());
+        for (Resource resource : addition.resources()) {
+            String input = content.resolve(resource);
+            if (input == null) throw new IOException("Prepared resource could not be resolved: " + resource.destination());
+            // Reference URI spelling is retained; copied files use the actual
+            // destination spelling, as the original publisher does on FAT.
+            String target = resource.copied() ? resource.destination() : resource.source();
+            if (resource.copied()) {
+                String actual = Utility.correctCaseSensitivePath(target);
+                if (actual != null) target = actual;
+            }
+            if (!target.startsWith(esp + "/")) throw new IOException("Boot resource is outside its ESP: " + target);
+            String keyword = resource.role().equals("kernel") || resource.role().equals("uki")
+                    ? Limine.PATH.toString() : Limine.MODULE_PATH.toString();
+            lines.add(spaces + keyword + " " + config.pathFunction() + target.substring(esp.length())
+                    + hash.suffix(resource, input));
+        }
+        lines.add(spaces + Limine.CMDLINE + " " + addition.cmdline());
+        lines.add("");
+        return lines;
+    }
+}
