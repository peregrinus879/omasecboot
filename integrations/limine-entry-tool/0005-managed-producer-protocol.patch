+package org.limine.entry.tool.processes;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.NoSuchFileException;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HexFormat;
+import java.util.Map;
+
+/** Exact before-state for a finite publication effect; leaf links are not followed. */
+public record FileState(String kind, String identity, String sha256, String linkTarget, int mode, long uid, long gid) {
+    public FileState {
+        if (!java.util.Set.of("absent", "file", "directory", "link").contains(kind)) throw new IllegalArgumentException("Unknown file state");
+        if (kind.equals("absent")) {
+            if (identity != null || sha256 != null || linkTarget != null || mode != 0 || uid != 0 || gid != 0) {
+                throw new IllegalArgumentException("Invalid absent state");
+            }
+        } else if (identity == null || !identity.matches("[0-9]+:[0-9]+")) {
+            throw new IllegalArgumentException("Invalid file identity");
+        }
+        if (kind.equals("file") != (sha256 != null) || (sha256 != null && !sha256.matches("[0-9a-f]{64}"))) {
+            throw new IllegalArgumentException("Invalid file digest");
+        }
+        if (kind.equals("link") != (linkTarget != null)) throw new IllegalArgumentException("Invalid link state");
+        int type = switch (kind) { case "file" -> 0100000; case "directory" -> 0040000; case "link" -> 0120000; default -> 0; };
+        if ((mode & 0170000) != type || (mode & ~0177777) != 0 || uid < 0 || gid < 0) {
+            throw new IllegalArgumentException("Invalid file metadata");
+        }
+    }
+
+    private static final String ATTRIBUTES = "unix:dev,ino,mode,uid,gid,size,lastModifiedTime,ctime";
+
+    public static FileState absent() { return new FileState("absent", null, null, null, 0, 0, 0); }
+
+    public static FileState capture(Path path) throws IOException {
+        Map<String, Object> attributes;
+        try {
+            attributes = Files.readAttributes(path, ATTRIBUTES, LinkOption.NOFOLLOW_LINKS);
+        } catch (NoSuchFileException e) {
+            return absent();
+        }
+        int type = ((Number) attributes.get("mode")).intValue() & 0170000;
+        String kind = switch (type) {
+            case 0100000 -> "file";
+            case 0040000 -> "directory";
+            case 0120000 -> "link";
+            default -> throw new IOException("Unsupported publication target type: " + path);
+        };
+        String identity = Long.toUnsignedString(((Number) attributes.get("dev")).longValue()) + ":"
+                + Long.toUnsignedString(((Number) attributes.get("ino")).longValue());
+        String hash = kind.equals("file") ? hash(path) : null;
+        String target = kind.equals("link") ? Files.readSymbolicLink(path).toString() : null;
+        if (!attributes.equals(Files.readAttributes(path, ATTRIBUTES, LinkOption.NOFOLLOW_LINKS))) {
+            throw new IOException("Publication target changed during observation: " + path);
+        }
+        return new FileState(kind, identity, hash, target, ((Number) attributes.get("mode")).intValue(),
+                Integer.toUnsignedLong(((Number) attributes.get("uid")).intValue()),
+                Integer.toUnsignedLong(((Number) attributes.get("gid")).intValue()));
+    }
+
+    public static String hash(Path path) throws IOException {
+        MessageDigest digest;
+        try {
+            digest = MessageDigest.getInstance("SHA-256");
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+        try (InputStream input = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) {
+            byte[] buffer = new byte[8192];
+            int count;
+            while ((count = input.read(buffer)) != -1) digest.update(buffer, 0, count);
+        }
+        return HexFormat.of().formatHex(digest.digest());
+    }
+
+    public boolean same(FileState current) {
+        return equals(current);
+    }
+
+    /** A replay stage has a new inode, but must preserve the intended bytes and metadata. */
+    public boolean sameContent(FileState current) {
+        return current != null && kind.equals("file") && current.kind.equals("file") && sha256.equals(current.sha256)
+                && mode == current.mode && uid == current.uid && gid == current.gid;
+    }
+}
