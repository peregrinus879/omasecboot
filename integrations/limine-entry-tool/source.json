    "test": {
      "command": "bash tests/integration/limine-description.sh /absolute/path/to/unpatched-source-root /absolute/path/to/jdk25 [native-executable]",
      "composition": "Apply the native failure patch and then the description patch, validating intermediate/final file bindings. The original source remains unchanged. The shell build/install patch is independently tested and applied by the package recipe.",
      "scope": "Real wrapper and native query at unprivileged namespace UID, with writable/read-only fixture domains, side-effect sentinels, configuration/association/error cases, as-read generation and macro interleaving, JSON round trips and actual publication parity. The optional executable runs queries through the built ELF; deterministic helpers and publication parity still use actual Java classes. Mutation/FAT admission, shell build selection, package inventory and lifecycle/boot proof remain separate.",
      "logs": "LIMINE_DESCRIPTION_KEEP=1 retains the printed private source/class/fixture/transcript directory; otherwise the suite removes it."
    }
  },
  "test": {
    "command": "bash tests/integration/limine-producer.sh /absolute/path/to/unpatched-source-root",
    "input": "No network access by the test. Supply the extracted pinned archive or an equivalent tree containing the three files above. The test copies and verifies each input SHA-256 before execution, verifies the patch and patched bytes, and leaves the caller's source unchanged. The archive digest binds the fetched archive; per-file digests are the executable input contract.",
    "requires": "Linux with unprivileged Bubblewrap user namespaces, merged-/usr runtime libraries, Bash, GNU coreutils, awk, util-linux flock, jq, patch, and ShellCheck.",
    "isolation": "Execute the complete real producer, common functions, and CLI wrapper in a private mount/PID/network/user namespace. Only runtime libraries and an explicit utility list are exposed read-only; /etc, /usr/lib/modules, /sys, /var, /boot, HOME and XDG paths are fixtures. mkinitcpio, entry-tool, pacman and host probes are fake commands. No OmaSecBoot core is sourced.",
    "logs": "Set TMPDIR to an owned private scratch parent. LIMINE_PRODUCER_KEEP=1 retains the printed per-run directory with source copies, fixtures and logs; otherwise the test removes it on exit."
  }
